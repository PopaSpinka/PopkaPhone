#!/bin/sh
# НаомиФон — запуск Need for Speed: Most Wanted на столе (docs/WINDOWS.md): на телефоне,
# ~/naomi/bin/nfsmw. Игра стоит в префиксе Wine (C:\Games\NFSMW). DirectX 9 — DXVK (как у FlatOut 2, device/flatout2);
# dinput8.dll игры — загрузчик её дополнений (папка scripts) — раньше встроенной; подмены — по её «Linux Readme.txt».
#   NAOMI_FPS=1 — счётчик кадров DXVK в углу; NAOMI_RATE=N — потолок кадров в секунду (по умолчанию 30, 0 — без него)
cd "$HOME/.local/share/naomi/win/prefix/drive_c/Games/NFSMW" || exit 1
export WINEDLLOVERRIDES="dinput8,dsound,d3d9,d3dx9_26,d3dx9_43,d3dcompiler_43=n,b;mscoree,mshtml="
[ -n "${NAOMI_FPS:-}" ] && export DXVK_HUD=fps
[ "${NAOMI_RATE:-30}" != 0 ] && export DXVK_FRAME_RATE=${NAOMI_RATE:-30}
exec "$HOME/naomi/bin/winrun" speed.exe
