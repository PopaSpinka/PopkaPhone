#!/usr/bin/env python3
# НаомиФон — убить все процессы Wine (docs/WINDOWS.md): те, чей исполняемый файл — наш Box64. Не pkill по имени:
# шаблон совпадает и с командной строкой того, кто его вызвал
import os, signal
for pid in filter(str.isdigit, os.listdir("/proc")):
    try:
        if os.readlink(f"/proc/{pid}/exe").endswith("/naomi/win/box64/box64"):
            os.kill(int(pid), signal.SIGKILL)
    except OSError:
        pass
