<?xml version="1.0" encoding="utf-8"?>
<!-- НаомиФон для планшета (docs/TABLET.md): стол телефона с приставки на Pi, касания — мышь стола; заставка без
     дока, пока стол на планшет не выведен; киоск — приложение вместо домашнего экрана (владелец устройства).
     Оно же — на телевизоре Android TV (docs/TV.md): плитка на главном экране, служба TvService — кнопка пульта и
     включение со стола -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.popka.naomiphone.tablet">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- телевизор: сенсорного экрана нет; плитка на главном экране Android TV — категория LEANBACK_LAUNCHER и banner -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="НаомиФон"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- киоск: домашний экран планшета — это приложение (выбирает владелец устройства, MainActivity.kiosk) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- телевизор (docs/TV.md): кнопка пульта открывает приложение; приставка через неё включает экран и открывает
             приложение поверх HDMI-входа. Включает пользователь (tools/tv access on); на планшете не включается -->
        <service
            android:name=".TvService"
            android:exported="true"
            android:label="@string/tv_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/tv_service" />
        </service>
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
