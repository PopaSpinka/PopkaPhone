def thread_detail(folder, word):
    tr = Trace(folder)
    cand = [r for r in tr.thread_rows() if word.lower() in r["label"].lower() or word == str(r["tid"])]
    if not cand:
        sys.exit(f"нет потока со словом «{word}»")
    r = cand[0]
    tr = Trace(folder, keep=r["tid"])
    tid = r["tid"]
    print(f"{r['label']} (tid {tid}), класс {sched_class(r)}, группа «{r['stune']}», разрешённые ядра {r['allowed']}")
    print(f"работал {r['ms']:.1f} мс ({r['ms'] / tr.dur / 10:.1f}% ядра), кусков {r['slices']}, переездов {r['mig']}")
    per = tr.run[tid]
    print("по ядрам, мс: " + " ".join(f"{c}{tr.kind[c]}:{per[c] * 1e3:.0f}" for c in range(tr.ncpu)))
    sl = sorted(e - s for s, e, _ in tr.slices)
    if sl:
        print(f"кусок работы: p50 {pct(sl, .5) * 1e3:.2f}, p95 {pct(sl, .95) * 1e3:.2f}, макс {sl[-1] * 1e3:.2f} мс")
    lat = tr.wake_lat.get(tid, [])
    print(f"ожидание после пробуждения: {len(lat)} раз, p50 {pct(lat, .5) * 1e3:.3f}, p95 {pct(lat, .95) * 1e3:.3f}, "
          f"p99 {pct(lat, .99) * 1e3:.3f}, макс {max(lat, default=0) * 1e3:.3f} мс; вытеснен {r['npreempt']} раз на {r['preempt']:.1f} мс")
    print("за кем стоял: " + ", ".join(f"{tr.label(t)} {d * 1e3:.1f} мс" for t, d in
                                        sorted(tr.steal[tid].items(), key=lambda x: -x[1])[:10]))
    print("кто будил: " + ", ".join(f"{tr.label(t)} ×{n}" for t, n in tr.wakers[tid].most_common(10)))
    print("блокировки в ядре: " + ("; ".join(f"{fn} ×{v[0]} {v[1] * 1e3:.1f} мс (худш. {v[2] * 1e3:.1f})" for fn, v in
                                            sorted(tr.blocked[tid].items(), key=lambda x: -x[1][1])[:10]) or "нет"))
    print("худшие ожидания:")
    for d, t, _, kind, cpu, occ in sorted((x for x in tr.waits if x[2] == tid), reverse=True)[:15]:
        print(f"  {t - tr.t0:7.3f} с {d * 1e3:6.1f} мс {kind:18s} ядро {cpu}{tr.kind[cpu]} за: {tr.label(occ) if occ else 'ядро просыпалось'}")


def compare(fa, fb):
    def s(folder):
        p = os.path.join(folder, "summary.json")
        if not os.path.exists(p):
            report(Trace(folder))
        with open(p) as f:
            return json.load(f)
    A, B = s(fa), s(fb)
    print(f"было: {os.path.basename(fa.rstrip('/'))} ({A['dur']:.1f} с) → стало: {os.path.basename(fb.rstrip('/'))} ({B['dur']:.1f} с)")
    print(f"занято ядер, % одного: {sum(A['busy']) * 100:.0f} → {sum(B['busy']) * 100:.0f}; "
          f"кабель {A['power_usb']:.2f} → {B['power_usb']:.2f} Вт; горячее всего {A['hot']:.1f} → {B['hot']:.1f} °C")
    print(f"ожиданий главных потоков ≥ 2 мс: {A['waits_over_2ms']} → {B['waits_over_2ms']}; ≥ 8 мс: {A['waits_over_8ms']} → {B['waits_over_8ms']}")
    print(f"видеочип занят, мс/с: {A['gpu_ms'] / A['dur']:.0f} → {B['gpu_ms'] / B['dur']:.0f}; "
          f"прерывания, мс/с: {(A['irq_ms'] + A['softirq_ms']) / A['dur']:.1f} → {(B['irq_ms'] + B['softirq_ms']) / B['dur']:.1f}")
    print("поток                                  мс/с было → стало   на малых %      ожидание p95 мс    вытеснен мс/с")
    names = sorted(set(A["threads"]) | set(B["threads"]),
                   key=lambda n: -max(A["threads"].get(n, {}).get("ms", 0) / A["dur"], B["threads"].get(n, {}).get("ms", 0) / B["dur"]))
    z = {"ms": 0, "little": 0, "lat95": 0, "preempt": 0}
    for n in names[:30]:
        x, y = A["threads"].get(n, z), B["threads"].get(n, z)
        print(f"  {n[:36]:36s} {x['ms'] / A['dur']:6.0f} → {y['ms'] / B['dur']:6.0f}     "
              f"{100 * x['little'] / (x['ms'] or 1):3.0f} → {100 * y['little'] / (y['ms'] or 1):3.0f}     "
              f"{x['lat95']:6.2f} → {y['lat95']:6.2f}    {x['preempt'] / A['dur']:6.1f} → {y['preempt'] / B['dur']:6.1f}")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        sys.exit(__doc__)
    if a[0] == "run":
        rest = a[1:]
        command = []
        if "--" in rest:
            i = rest.index("--")
            rest, command = rest[:i], rest[i + 1:]
        secs = next((x for x in rest if x.replace(".", "").isdigit()), "10")
        extra = [x for x in rest if x == "idle"]
        name = next((x for x in rest if x != secs and x != "idle"), "")
        out = record(float(secs), name, extra, command)
        print(report(Trace(out)))
        print(f"→ {os.path.relpath(out, ROOT)}/report.txt")
    elif a[0] == "again" and len(a) >= 2:
        focus = "|".join(a[2:]) or FOCUS
        print(report(Trace(a[1].rstrip("/"), focus)))
    elif a[0] == "step" and len(a) >= 2:
        folder = a[1].rstrip("/")
        steps = steps_of(folder)
        if len(a) == 2:
            for s_ in steps:
                print(f"  {s_['name']:24s} {s_['t1'] - s_['t0']:6.1f} с")
        elif len(a) == 4:
            t0 = json.load(open(os.path.join(folder, "state.json")))["t0"]
            print(report(Trace(folder, window=(t0 + float(a[2]), t0 + float(a[3])), title=f"{a[2]}–{a[3]} с")))
        else:
            hit = [s_ for s_ in steps if s_["name"] == a[2]] or [s_ for s_ in steps if a[2] in s_["name"]]
            if not hit:
                sys.exit(f"нет шага «{a[2]}»: " + ", ".join(s_["name"] for s_ in steps))
            for s_ in hit:
                print(report(Trace(folder, window=(s_["t0"], s_["t1"]), title=s_["name"])))
    elif a[0] in ("trap", "disk"):
        rest, command = a[1:], []
        if "--" in rest:
            i = rest.index("--")
            rest, command = rest[:i], rest[i + 1:]
        (trap if a[0] == "trap" else disk)(float(rest[0]) if rest else 30.0, command)
    elif a[0] == "compare" and len(a) == 3:
        compare(a[1], a[2])
    elif a[0] == "thread" and len(a) == 3:
        thread_detail(a[1].rstrip("/"), a[2])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
