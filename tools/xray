def around(start, stop, secs, command):
    """start на телефоне → ждать секунды или команду на Mac → stop; ответ — вывод stop."""
    os.environ.setdefault("NAOMI_VIA", "wifi")
    naomi = load("naomi")
    for f in ("uitrap.sh", "ioprobe.py"):
        naomi.push(os.path.join(ROOT, "device", f), f"/home/phablet/naomi/bin/{f}")
    p = subprocess.run(naomi.ssh_argv(start), capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit(f"не началось: {p.stderr.strip() or p.stdout.strip()}")
    if command:
        subprocess.run(command, cwd=ROOT)
    else:
        time.sleep(secs)
    return subprocess.run(naomi.ssh_argv(stop), capture_output=True, text=True, errors="replace").stdout


def trap(secs, command):
    text = around("sudo -n sh ~/naomi/bin/uitrap.sh start",
                  "sudo -n sh ~/naomi/bin/uitrap.sh stop /tmp/naomi-trap.txt; cat /tmp/naomi-trap.txt", secs, command)
    out = os.path.join(ROOT, "reports", f"trap-{time.strftime('%Y%m%d-%H%M%S')}.txt")
    with open(out, "w") as f:
        f.write(text)
    when = re.compile(r"\s(\d+\.\d+): (\w+):")
    switch = re.compile(r"prev_pid=(\d+) .*prev_state=(\S+) ==> .*next_pid=(\d+)")
    ui, cur, rows = None, None, []
    for line in text.splitlines():
        m = when.search(line)
        if m and m.group(2) == "sched_switch":
            s = switch.search(line)
            if not s:
                continue
            if ui is None and "prev_comm=naomi-shell" in line:
                ui = s.group(1)
            if s.group(1) == ui and s.group(2).startswith("D"):
                cur = {"t": float(m.group(1)), "stack": [], "why": ""}
            elif s.group(3) == ui and cur:
                cur["dur"] = float(m.group(1)) - cur["t"]
                rows.append(cur)
                cur = None
        elif m and m.group(2) == "sched_blocked_reason" and cur:
            cur["why"] = line.split("caller=")[-1].split("+")[0] + (" (диск)" if "iowait=1" in line else "")
        elif line.strip().startswith("=>") and cur is not None:
            cur["stack"].append(line.strip()[3:].split("+")[0].strip())
    print(f"поток интерфейса оболочки: засыпаний не по своей воле {len(rows)}, всего "
          f"{sum(r['dur'] for r in rows) * 1e3:.0f} мс; от 8 мс — {len([r for r in rows if r['dur'] >= 0.008])}")
    by = collections.defaultdict(lambda: [0, 0.0, 0.0])
    for r in rows:   # первые два кадра стека — сама запись события и планировщик
        k = by[(r["why"] or "?") + " ← " + " ← ".join(r["stack"][2:9])]
        k[0] += 1
        k[1] += r["dur"]
        k[2] = max(k[2], r["dur"])
    for k, v in sorted(by.items(), key=lambda x: -x[1][1])[:14]:
        print(f"  ×{v[0]:<4d} {v[1] * 1e3:7.1f} мс (худш. {v[2] * 1e3:5.1f})  {k}")
    print("самые долгие (секунда по часам телефона — как в трассе стола):")
    for r in sorted(rows, key=lambda r: -r["dur"])[:5]:
        print(f"  {r['dur'] * 1e3:6.1f} мс в {r['t']:.3f}: " + " ← ".join(r["stack"][2:18]))
    print(f"→ {os.path.relpath(out, ROOT)}")


def disk(secs, command):
    # номер процесса — в файл: pkill по имени убил бы и саму команду SSH (имя есть в её строке)
    text = around("(sudo -n setsid nohup sh -c 'echo $$ > /tmp/naomi-ioprobe.pid; exec python3 "
                  f"/home/phablet/naomi/bin/ioprobe.py {3600 if command else secs + 2} /tmp/naomi-ioprobe.txt' "
                  ">/dev/null 2>&1 < /dev/null &); sleep 0.5",
                  "sudo -n kill $(cat /tmp/naomi-ioprobe.pid) 2>/dev/null; sleep 0.3; cat /tmp/naomi-ioprobe.txt",
                  secs, command)
    lat = sorted(int(l.split()[1]) / 1e3 for l in text.splitlines() if len(l.split()) == 2)
    if not lat:
        sys.exit("проб нет")
    print(f"чтение с диска 4 КБ мимо кэша, проб {len(lat)}: середина {pct(lat, .5):.1f} мс, 95 % {pct(lat, .95):.1f}, "
          f"99 % {pct(lat, .99):.1f}, худшее {lat[-1]:.0f} мс; дольше 10 мс — {sum(1 for x in lat if x > 10)}, "
          f"дольше 30 мс — {sum(1 for x in lat if x > 30)}")


