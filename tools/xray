#!/usr/bin/env python3
"""НаомиФон — «рентген» телефона (docs/XRAY.md): запись трассы ядра и снимков /proc на N секунд и разбор — кто
сколько работал, на каких ядрах, сколько ждал своей очереди и за кем, что его блокировало, прерывания, частоты, сон
ядер, видеочип по процессам, память, тепло, мощность, сеть.

  tools/xray run [сек] [имя] [idle] [-- команда …]   запись (10 с) и разбор → reports/xray-ДАТА-имя/report.txt;
                                    команда после «--» запускается на Mac через 1 с после начала записи (сценарий:
                                    tools/naomi mouse …, tools/deskbench …); idle — писать и засыпания ядер
  tools/xray again ПАПКА [слово …]  разобрать записанное снова; слова — какие потоки считать главными (см. FOCUS)
  tools/xray step ПАПКА [шаг | С ПО]  только отрезок записи: шаг сценария (запись из tools/deskbench; без шага —
                                    список шагов) или секунды от начала записи
  tools/xray compare A B            сравнить две записи: ядра, главные потоки, ожидания
  tools/xray thread ПАПКА СЛОВО     один поток подробно: куски работы, где ждал, за кем, что блокировало
  tools/xray trap [сек] [-- команда …]  «ловушка»: где поток интерфейса оболочки засыпает не по своей воле (диск,
                                    замок, память) — стек ядра каждого такого засыпания, сводка по причинам. Пишет
                                    только этот поток: не мешает и не переполняется (device/uitrap.sh)
  tools/xray disk [сек] [-- команда …]  задержка диска «со стороны стола»: чтение 4 КБ мимо кэша раз в 20 мс
                                    (device/ioprobe.py) — середина, 95 %, 99 %, худшее
                                    (у обеих: без команды — сек секунд (30); с командой — пока она работает)

Телефон только пишет (device/xray.py), разбор — здесь. Часы трассы — CLOCK_MONOTONIC телефона, как у трассы стола
(зонд /probe) и журнала оболочки (-o short-monotonic): записи можно сводить по времени.
"""
import collections
import gzip
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import threading
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PHONE_DIR = "/tmp/xray"
# Потоки, от которых зависит плавность: для них — подробный разбор ожиданий
FOCUS = r"naomi|QSG|QQml|Qt|venc|Venus|Chrome|Compositor|Viz|CrGpu|CrRenderer|pulse|waydroid|surfacefl|composer|" \
        r"allocator|RenderThread|HwBinder|binder:|kgsl|vidc|crtc|sde|wlan|cds_|dwc3|usb|ncm"
LINE = re.compile(r"^\s*(.+)-(\d+)\s+\(\s*([-\d]+)\)\s+\[(\d+)\]\s+(\S+)\s+(\d+\.\d+):\s+(\w+):\s?(.*)$")
SWITCH = re.compile(r"prev_comm=(.*) prev_pid=(\d+) prev_prio=(\d+) prev_state=(\S+) ==> next_comm=(.*) "
                    r"next_pid=(\d+) next_prio=(\d+)")
WAKE = re.compile(r"comm=(.*) pid=(\d+) prio=(\d+) target_cpu=(\d+)")
KV = re.compile(r"(\w+)=(\S+)")


def load(name):
    loader = importlib.machinery.SourceFileLoader(name, os.path.join(ROOT, "tools", name))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def pct(v, q):
    if not v:
        return 0.0
    v = sorted(v)
    return v[min(len(v) - 1, int(len(v) * q))]


# ───────────────────────── запись ─────────────────────────

def record(secs, name, extra, command):
    os.environ.setdefault("NAOMI_VIA", "wifi")   # кабель телефона обычно у приставки
    naomi = load("naomi")
    out = os.path.join(ROOT, "reports", f"xray-{time.strftime('%Y%m%d-%H%M%S')}" + (f"-{name}" if name else ""))
    os.makedirs(out)
    naomi.push(os.path.join(ROOT, "device", "xray.py"), "/home/phablet/naomi/bin/xray.py")
    side = None
    if command:
        def run_side():
            time.sleep(1.0)
            with open(os.path.join(out, "command.log"), "w") as log:
                log.write(" ".join(command) + "\n")
                log.flush()
                subprocess.run(command, stdout=log, stderr=subprocess.STDOUT, cwd=ROOT)
        side = threading.Thread(target=run_side)
        side.start()
    p = subprocess.run(naomi.ssh_argv(f"sudo -n rm -rf {PHONE_DIR}; sudo -n python3 ~/naomi/bin/xray.py {secs} "
                                      f"{PHONE_DIR} {' '.join(extra)}"), capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit(f"запись не удалась: {p.stderr.strip() or p.stdout.strip()}")
    if side:
        side.join()
    tar = subprocess.Popen(naomi.ssh_argv(f"tar -C {PHONE_DIR} -cf - ."), stdout=subprocess.PIPE)
    subprocess.run(["tar", "-C", out, "-xf", "-"], stdin=tar.stdout, check=True)
    tar.wait()
    subprocess.run(naomi.ssh_argv(f"sudo -n rm -rf {PHONE_DIR}"), capture_output=True)
    return out


# ───────────────────────── разбор трассы ─────────────────────────

class Trace:
    """Всё, что вынуто из трассы: по потокам, ядрам, прерываниям, видеочипу."""

    def __init__(self, folder, focus=FOCUS, keep=None, window=None, title=""):
        self.folder = folder
        self.window = window       # (с, по) в секундах часов телефона — разбирать только этот отрезок (шаг сценария)
        self.title = title
        with open(os.path.join(folder, "state.json")) as f:
            self.state = json.load(f)
        self.focus = re.compile(focus)
        self.keep = keep           # tid, для которого хранить все куски (tools/xray thread)
        self.slices = []           # (с, по, ядро) — только для keep
        cap = self.state["static"]["capacity"]
        self.ncpu = len(cap)
        self.cap = [cap[f"cpu{i}"] for i in range(self.ncpu)]
        top, low = max(self.cap), min(self.cap)
        self.kind = ["м" if c == low else ("г" if c == top else "б") for c in self.cap]   # малое, большое, главное
        self.name, self.tgid = {}, {}
        for snap in ("a", "b"):
            for tid, t in self.state[snap]["threads"].items():
                self.name[int(tid)] = t["comm"]
                self.tgid[int(tid)] = t["pid"]
        self.run = collections.defaultdict(lambda: [0.0] * self.ncpu)
        self.nslice = collections.Counter()
        self.mig = collections.Counter()
        self.wake_lat = collections.defaultdict(list)     # tid → [с] от пробуждения до ядра
        self.preempt = collections.defaultdict(float)     # tid → с вытеснен (готов работать, а ядро отняли)
        self.npreempt = collections.Counter()
        self.blocked = collections.defaultdict(lambda: collections.defaultdict(lambda: [0, 0.0, 0.0]))
        self.waits = []                                   # (длилось, когда, tid, вид, ядро, за кем)
        self.steal = collections.defaultdict(lambda: collections.defaultdict(float))   # tid → кто → с
        self.wakers = collections.defaultdict(collections.Counter)
        self.irq = collections.defaultdict(lambda: {"n": 0, "t": 0.0, "max": 0.0, "cpu": collections.Counter()})
        self.soft = collections.defaultdict(lambda: {"n": 0, "t": 0.0, "max": 0.0, "cpu": collections.Counter()})
        self.irq_cpu = [0.0] * self.ncpu
        self.freq_changes = collections.Counter()
        self.limits = []
        self.gpu_ctx = {}                                  # ctx → tgid
        self.gpu_time = collections.defaultdict(float)     # tgid → с видеочипа
        self.gpu_jobs = collections.Counter()
        self.gpu_state = collections.defaultdict(float)
        self.gpu_levels = collections.Counter()
        self.vidc = collections.Counter()
        self.cdev = []
        self.marks = []
        self.t0 = self.t1 = None
        self.cpu_last = [None] * self.ncpu                 # последнее событие ядра (переполнился буфер — ядро замолкает)
        self.lines = 0
        self.parse()

    def label(self, tid):
        """«процесс/поток» для потока."""
        n = self.name.get(tid, "?")
        pid = self.tgid.get(tid)
        if pid and pid != tid:
            return f"{self.proc_name(pid)}/{n}"
        return self.proc_name(tid) if pid == tid else n

    def proc_name(self, pid):
        t = self.state["b"]["threads"].get(str(pid)) or self.state["a"]["threads"].get(str(pid))
        if not t:
            return self.name.get(pid, str(pid))
        cmd = t["cmd"].split()
        base = os.path.basename(cmd[0]) if cmd else ""
        # у служб Android имя главного потока — «binder:…», «main»: полезнее имя программы
        if base and (t["comm"].startswith(("binder:", "main", "HwBinder")) or t["comm"] in ("sh", "python3")):
            return base[:24]
        return t["comm"]

    def parse(self):
        ncpu = self.ncpu
        cur = [None] * ncpu          # (tid, с какого времени)
        wake_at = {}                 # tid → (когда, ядро, кто его занимал)
        pre_at = {}                  # tid → (когда, кто вытеснил)
        out_at = {}                  # tid → когда ушёл спать
        irq_in = [None] * ncpu
        soft_in = [None] * ncpu
        gpu_sub = {}
        gpu_state, gpu_since = None, None
        run, name, tgid = self.run, self.name, self.tgid
        keep = self.keep
        wa, wb = self.window or (float("-inf"), float("inf"))

        def clip(s0, e0):
            return max(0.0, min(e0, wb) - max(s0, wa))
        with gzip.open(os.path.join(self.folder, "trace.gz"), "rt", errors="replace") as f:
            for line in f:
                m = LINE.match(line)
                if not m:
                    continue
                self.lines += 1
                comm, tid, tg, cpu, flags, ts, ev, rest = m.groups()
                tid, cpu, ts = int(tid), int(cpu), float(ts)
                if self.t0 is None:
                    self.t0 = ts
                if ts > wb:
                    break
                self.t1 = ts
                self.cpu_last[cpu] = ts
                inw = ts >= wa
                if tg[0] != "-" and tid:
                    tgid.setdefault(tid, int(tg))
                if ev == "sched_switch":
                    s = SWITCH.match(rest)
                    if not s:
                        continue
                    pc, pp, _, pstate, nc, np_, _ = s.groups()
                    pp, np_ = int(pp), int(np_)
                    name[pp] = pc
                    name[np_] = nc
                    c = cur[cpu]
                    if c and c[0] == pp:
                        run[pp][cpu] += clip(c[1], ts)
                        if keep == pp and inw:
                            self.slices.append((c[1], ts, cpu))
                    elif c is None:
                        run[pp][cpu] += clip(self.t0, ts)
                    if inw:
                        self.nslice[pp] += 1
                    if pp:
                        if pstate[0] == "R":
                            pre_at[pp] = (ts, np_)
                            if inw:
                                self.npreempt[pp] += 1
                        else:
                            out_at[pp] = ts
                    cur[cpu] = (np_, ts)
                    if np_ and not inw:
                        wake_at.pop(np_, None)
                        pre_at.pop(np_, None)
                    elif np_:
                        w = wake_at.pop(np_, None)
                        if w:
                            d = ts - w[0]
                            self.wake_lat[np_].append(d)
                            if d >= 0.002:
                                self.waits.append((d, w[0], np_, "после пробуждения", cpu, w[2]))
                            if d >= 0.0005 and w[2]:
                                self.steal[np_][w[2]] += d
                        p = pre_at.pop(np_, None)
                        if p:
                            d = ts - p[0]
                            self.preempt[np_] += d
                            if d >= 0.002:
                                self.waits.append((d, p[0], np_, "вытеснен", cpu, p[1]))
                            self.steal[np_][p[1]] += d
                elif ev in ("sched_wakeup", "sched_wakeup_new"):
                    w = WAKE.match(rest)
                    if not w:
                        continue
                    wc, wp, _, tc = w.groups()
                    wp, tc = int(wp), int(tc)
                    name[wp] = wc
                    if wp not in wake_at and wp not in pre_at:
                        occ = cur[tc][0] if tc < ncpu and cur[tc] else 0
                        wake_at[wp] = (ts, tc, occ)
                        if tid and flags[2] == ".":
                            self.wakers[wp][tid] += 1
                elif not inw:
                    if ev == "adreno_cmdbatch_queued":
                        self.gpu_ctx[dict(KV.findall(rest)).get("ctx")] = tgid.get(tid, tid)
                    elif ev == "kgsl_pwr_set_state":
                        gpu_state, gpu_since = rest[rest.find("state=") + 6:].strip(), wa
                    elif ev == "irq_handler_entry" or ev == "softirq_entry":
                        irq_in[cpu] = soft_in[cpu] = None
                elif ev == "sched_migrate_task":
                    k = dict(KV.findall(rest))
                    self.mig[int(k.get("pid", 0))] += 1
                elif ev == "sched_blocked_reason":
                    k = dict(KV.findall(rest))
                    p = int(k.get("pid", 0))
                    since = out_at.get(p)
                    if since is not None:
                        rec = self.blocked[p][k.get("caller", "?").split("+")[0] + (" (диск)" if k.get("iowait") == "1" else "")]
                        d = ts - since
                        rec[0] += 1
                        rec[1] += d
                        rec[2] = max(rec[2], d)
                elif ev == "irq_handler_entry":
                    k = dict(KV.findall(rest))
                    irq_in[cpu] = (ts, f"{k.get('name', '?')} [{k.get('irq')}]")
                elif ev == "irq_handler_exit":
                    if irq_in[cpu]:
                        d = ts - irq_in[cpu][0]
                        r = self.irq[irq_in[cpu][1]]
                        r["n"] += 1
                        r["t"] += d
                        r["max"] = max(r["max"], d)
                        r["cpu"][cpu] += 1
                        self.irq_cpu[cpu] += d
                        irq_in[cpu] = None
                elif ev == "softirq_entry":
                    soft_in[cpu] = (ts, rest[rest.find("action=") + 7:].rstrip("]"))
                elif ev == "softirq_exit":
                    if soft_in[cpu]:
                        d = ts - soft_in[cpu][0]
                        r = self.soft[soft_in[cpu][1]]
                        r["n"] += 1
                        r["t"] += d
                        r["max"] = max(r["max"], d)
                        r["cpu"][cpu] += 1
                        self.irq_cpu[cpu] += d
                        soft_in[cpu] = None
                elif ev == "cpu_frequency":
                    k = dict(KV.findall(rest))
                    self.freq_changes[int(k.get("cpu_id", 0))] += 1
                elif ev in ("cpu_frequency_limits", "dcvsh_freq"):
                    self.limits.append((ts, ev, rest.strip()))
                elif ev == "adreno_cmdbatch_queued":
                    k = dict(KV.findall(rest))
                    self.gpu_ctx[k.get("ctx")] = tgid.get(tid, tid)
                elif ev == "adreno_cmdbatch_submitted":
                    k = dict(KV.findall(rest))
                    gpu_sub[(k.get("ctx"), k.get("ts"))] = ts
                elif ev == "adreno_cmdbatch_retired":
                    k = dict(KV.findall(rest))
                    s0 = gpu_sub.pop((k.get("ctx"), k.get("ts")), None)
                    owner = self.gpu_ctx.get(k.get("ctx"), f"ctx{k.get('ctx')}")
                    self.gpu_jobs[owner] += 1
                    if s0 is not None:
                        self.gpu_time[owner] += ts - s0
                elif ev == "kgsl_pwr_set_state":
                    st = rest[rest.find("state=") + 6:].strip()
                    if gpu_state:
                        self.gpu_state[gpu_state] += ts - gpu_since
                    gpu_state, gpu_since = st, ts
                elif ev == "kgsl_pwrlevel":
                    k = dict(KV.findall(rest))
                    self.gpu_levels[k.get("freq", k.get("pwrlevel", "?"))] += 1
                elif ev.startswith("msm_v4l2_vidc"):
                    self.vidc[ev] += 1
                elif ev == "cdev_update":
                    self.cdev.append((ts, rest.strip()))
                elif ev == "tracing_mark_write":
                    self.marks.append((ts, rest.strip()))
        if self.t0 is None:
            sys.exit("трасса пустая")
        if self.t1 is None:
            self.t1 = self.t0
        self.base = max(self.t0, wa)
        end = min(self.t1, wb) if self.window else self.t1
        for cpu in range(ncpu):
            c = cur[cpu]
            if c:
                run[c[0]][cpu] += max(0.0, end - max(c[1], self.base))
            else:   # ядро за всю запись ни разу не переключилось — спало
                run[0][cpu] += max(0.0, end - self.base)
        if gpu_state:
            self.gpu_state[gpu_state] += max(0.0, end - max(gpu_since, self.base))
        self.dur = max(1e-6, end - self.base)

    # ───────── сводки ─────────

    def cpu_busy(self):
        """Занятость ядер по трассе: всё, кроме потока простоя."""
        busy = [0.0] * self.ncpu
        for tid, per in self.run.items():
            if tid:
                for c in range(self.ncpu):
                    busy[c] += per[c]
        return [b / self.dur for b in busy]

    def thread_rows(self):
        rows = []
        th_b = self.state["b"]["threads"]
        th_a = self.state["a"]["threads"]
        for tid, per in self.run.items():
            if not tid:
                continue
            total = sum(per)
            by = {"м": 0.0, "б": 0.0, "г": 0.0}
            for c in range(self.ncpu):
                by[self.kind[c]] += per[c]
            info = th_b.get(str(tid)) or th_a.get(str(tid)) or {}
            lat = self.wake_lat.get(tid, [])
            rows.append({
                "tid": tid, "pid": self.tgid.get(tid, tid), "label": self.label(tid), "ms": total * 1e3,
                "little": by["м"] * 1e3, "big": by["б"] * 1e3, "prime": by["г"] * 1e3,
                "slices": self.nslice[tid], "mig": self.mig[tid],
                "lat50": pct(lat, 0.5) * 1e3, "lat95": pct(lat, 0.95) * 1e3, "latmax": max(lat, default=0) * 1e3,
                "wakes": len(lat), "preempt": self.preempt.get(tid, 0) * 1e3, "npreempt": self.npreempt[tid],
                "blocked": sum(r[1] for r in self.blocked.get(tid, {}).values()) * 1e3,
                "nice": info.get("nice"), "policy": info.get("policy", 0), "rtprio": info.get("rtprio", 0),
                "stune": info.get("stune", ""), "allowed": info.get("allowed", ""),
            })
        rows.sort(key=lambda r: -r["ms"])
        return rows

    def proc_rows(self, rows):
        procs = {}
        for r in rows:
            p = procs.setdefault(r["pid"], {"pid": r["pid"], "name": self.proc_name(r["pid"]), "ms": 0, "little": 0,
                                            "big": 0, "prime": 0, "threads": 0, "preempt": 0})
            for k in ("ms", "little", "big", "prime", "preempt"):
                p[k] += r[k]
            p["threads"] += 1
        return sorted(procs.values(), key=lambda p: -p["ms"])


# ───────────────────────── отчёт ─────────────────────────

def sched_class(r):
    if r["policy"] == 1:
        return f"FIFO{r['rtprio']}"
    if r["policy"] == 2:
        return f"RR{r['rtprio']}"
    if r["policy"] == 3:
        return "batch"
    if r["policy"] == 5:
        return "idle"
    return f"{r['nice']:+d}" if r["nice"] else "0" if r["nice"] is not None else "?"


def watts(p):
    return p["usb_uv"] * p["usb_ua"] / 1e12, p["bat_uv"] * p["bat_ua"] / 1e12


def report(tr, save=True):
    """Полный отчёт; для отрезка (шаг сценария) — только то, что берётся из трассы: снимки /proc сняты по краям
    всей записи и к отрезку не относятся."""
    whole = tr.window is None
    st, a, b = tr.state, tr.state["a"], tr.state["b"]
    dur = tr.dur
    L = []
    w = L.append
    rows = tr.thread_rows()
    procs = tr.proc_rows(rows)
    busy = tr.cpu_busy()
    hz = st["static"]["hz"]

    w(f"РЕНТГЕН ТЕЛЕФОНА — {os.path.basename(tr.folder)}" + (f" — {tr.title}" if tr.title else ""))
    w((f"запись {dur:.2f} с" if whole else f"отрезок {dur:.2f} с (с {tr.base:.3f} по часам телефона)") +
      f", событий ядра {tr.lines}, работает {st['static']['uptime'] / 60:.0f} мин; "
      f"потоков {len(b['threads'])}, процессов {len({t['pid'] for t in b['threads'].values()})}")
    # Буфер ядра не перезаписывается: переполнился — ядро до конца записи молчит, и потоков на нём с этого места
    # не видно («работал» превращается в «ждал»). Отрезку, задевшему такое молчание, верить нельзя
    lost = {int(c[3:]): sum(int(l.split(":")[1]) for l in v if l.startswith(("overrun", "dropped")))
            for c, v in st["buffers"].items()}
    lost = {c: n for c, n in sorted(lost.items()) if n}
    blind = [c for c in lost if tr.cpu_last[c] is None or tr.t1 - tr.cpu_last[c] > 0.2]
    summary_lost = {"lost": {f"cpu{c}": n for c, n in lost.items()}, "blind": [f"cpu{c}" for c in blind]}
    if lost:
        w("  ВНИМАНИЕ: буфер трассы переполнился, потеряно событий: " + ", ".join(
            f"ядро {c} — {n}" + (f" (молчит с {tr.cpu_last[c] - tr.t0:.1f} с записи)" if c in blind and
                                 tr.cpu_last[c] is not None else "") for c, n in lost.items()))
        w("  " + (f"ЭТОМУ ОТЧЁТУ НЕ ВЕРИТЬ: с этого места потоков на ядрах {', '.join(map(str, blind))} не видно — доли по "
                  f"ядрам, ожидания и «кто отнял ядро» неверны. Запись короче или шаг раньше" if blind else
                  "этот отрезок цел: потери — после него"))
    if st["missing_events"]:
        w(f"  ВНИМАНИЕ: нет событий в ядре: {st['missing_events']}")
    ua, ub = watts(a["power"]), watts(b["power"])
    if whole:
