#!/usr/bin/env python3
"""НаомиФон — как ходит курсор живой мыши на приставке (docs/PI.md, «Мышь»).

  tools/pi-mouse [сек]        записать мышь Pi (по умолчанию 40 с): приёмник в SSH с NAOMI_DOCK_PTRACE, служба на это
                              время остановлена; води мышью, как обычно → reports/mouse-*/mouse.csv и разбор
  tools/pi-mouse папка …      разобрать записанное

Разбор: отчёты мыши (частота, ровность, отсчёты); курсор на экране в каждое обновление монитора — неровность (шаг против
среднего за ±3 обновления, там, где курсор едет быстрее 3 пикселей за обновление) и доля рывков (> 40 %); проскок
курсора за точку, где мышь остановилась.
"""
import csv
import math
import os
import statistics as st
import subprocess
import sys
import time
from collections import Counter

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
P = 1e6 / 74.96


def record(sec):
    out = os.path.join(ROOT, "reports", f"mouse-{time.strftime('%Y%m%d-%H%M%S')}")
    os.makedirs(out)
    print(f"запись {sec} с — води мышью Pi", flush=True)
    subprocess.run([os.path.join(ROOT, "tools", "pi"), "try", str(sec)], env=dict(os.environ, PI_ENV=
                   "NAOMI_DOCK_PTRACE=/tmp/mouse.csv"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run([os.path.join(ROOT, "tools", "pi"), "run"])
    ssh = subprocess.run([sys.executable, os.path.join(ROOT, "tools", "pi"), "ssh", "cat /tmp/mouse.csv"],
                         capture_output=True, text=True).stdout
    open(os.path.join(out, "mouse.csv"), "w").write(ssh)
    return out


def report(d):
    rows = list(csv.DictReader(open(os.path.join(d, "mouse.csv"))))
    m = [(int(r["t"]), int(float(r["x"])), int(float(r["y"]))) for r in rows if r["kind"] == "m"]
    raw = [(int(r["t"]), float(r["x"]), float(r["y"])) for r in rows if r["kind"] == "r"]
    c = sorted((int(r["t"]), float(r["x"]), float(r["y"])) for r in rows if r["kind"] == "c")
    if len(m) < 10 or len(c) < 10:
        return f"{os.path.basename(d)}: мало данных (мышью не водили?)"
    dt = [(b[0] - a[0]) / 1000 for a, b in zip(m, m[1:]) if b[0] - a[0] < 50000]
    cnt = [math.hypot(x, y) for _, x, y in m]
    out = (f"{os.path.basename(d)}: отчётов мыши {len(m)} — шаг {st.median(dt):.2f} мс ({1000 / st.median(dt):.1f} Гц), "
           f"«почти разом» (< 3 мс): {sum(1 for x in dt if x < 3)}; самые частые шаги: "
           f"{', '.join(f'{k} мс × {v}' for k, v in Counter(round(x) for x in dt).most_common(3))}; "
           f"сдвиг за отчёт: медиана {st.median(cnt):.1f} отсчёта")
    steps = [(b[1] - a[1], b[2] - a[2]) for a, b in zip(c, c[1:]) if b[0] - a[0] < 1.5 * P]
    errs = []
    for k in range(3, len(steps) - 3):
        sx = sum(s[0] for s in steps[k - 3:k + 4]) / 7
        sy = sum(s[1] for s in steps[k - 3:k + 4]) / 7
        sp = math.hypot(sx, sy)
        if sp >= 3:
            errs.append(math.hypot(steps[k][0] - sx, steps[k][1] - sy) / sp)
    errs.sort()
    if errs:
        out += (f"\n  курсор на экране: неровность {100 * st.median(errs):.0f}% (90%: {100 * errs[int(.9 * len(errs))]:.0f}%), "
                f"рывков > 40 %: {100 * sum(1 for e in errs if e > .4) / len(errs):.1f}% из {len(errs)} обновлений")
    stops = [k for k in range(1, len(raw) - 1) if raw[k + 1][0] - raw[k][0] > 100000 and raw[k][0] - raw[k - 1][0] < 40000]
    over = []
    for k in stops:
        t, x, y = raw[k]
        j = k
        while j > 0 and t - raw[j - 1][0] <= 50000:
            j -= 1
        vx, vy = x - raw[j][1], y - raw[j][2]
        n = math.hypot(vx, vy)
        if n >= 5:
            over.append(max([((px - x) * vx + (py - y) * vy) / n for tt, px, py in c if t - 30000 < tt < t + 150000] or [0]))
    if over:
        out += f"\n  остановок {len(over)}: проскок курсора за точку остановки — медиана {st.median(over):.1f}, макс {max(over):.1f} пикс"
    return out


def main():
    args = sys.argv[1:]
    if args and os.path.isdir(args[0]):
        for d in args:
            print(report(d))
        return
    print(report(record(int(args[0]) if args else 40)))


if __name__ == "__main__":
    main()
