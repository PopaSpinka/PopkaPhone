def stream_fps():
    """сколько кадров в секунду сейчас шлёт трансляция (строки журнала оболочки за последние 3 с; нет строк — 0)"""
    out = phone("journalctl -u naomi-shell --since '-3 s' --no-pager -o cat | grep -o 'naomi.stream: кадров [0-9]*' "
                "| tail -2; true", check=False)
    n = [int(x.split()[-1]) for x in out.splitlines() if x.strip()]
