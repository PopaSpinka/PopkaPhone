def stream_gpu(sec=4):
    """цена кадра стола на видеочипе, мс (строки журнала оболочки за последние sec секунд): (всего, кадр, упаковка) —
    медианы по строкам, где шло не меньше 60 кадров в секунду; частей может не быть (None)"""
    out = phone(f"journalctl -u naomi-shell --since '-{sec} s' --no-pager -o cat | grep 'naomi.stream: кадров'; true",
                check=False)
    rows = []
    for l in out.splitlines():
        try:
            if int(l.split("кадров ")[1].split(",")[0]) < 60:
                continue
            g = l.split("видеочип ")[1]
            total = float(g.split(":")[0].split(";")[0].split(")")[0].split(",")[0])
            parts = (float(g.split("кадр ")[1].split(",")[0]), float(g.split("упаковка ")[1].split(";")[0])) \
                if "упаковка" in g else (None, None)
            rows.append((total,) + parts)
        except (IndexError, ValueError):
            pass
    if not rows:
        return None
    med = lambda i: statistics.median(r[i] for r in rows) if rows[0][i] is not None else None
    return med(0), med(1), med(2)


def s_android_windows(b):
    """Цена кадра оболочки на видеочипе от числа окон Android: игра (рисует 75 кадров в секунду) одна, потом рядом
    «Настройки», потом ещё «Калькулятор» — по 6 с покоя; в заметках — мс видеочипа на кадр стола (журнал трансляции)"""
    for pkg in (A_SETTINGS, A_CALC):
        if pkg in a_wins(b.look()):
            a_close(b, pkg)
    game_ready(b)
    a_place(b, A_GAME, 700, 100, 540, 870)   # игра могла остаться развёрнутой — в окно, как всегда
    b.to((b.dw * 0.5, b.dh * 0.985))
    note = []
    for name, pkg, place in (("одно", None, None), ("два", A_SETTINGS, (60, 90, 620, 640)),
                             ("три", A_CALC, (1300, 420, 400, 520))):
        if pkg:
            a_open(b, pkg)
            a_place(b, pkg, *place)
            b.to((b.dw * 0.5, b.dh * 0.985))
        with b.step(f"окна-android.{name}"):
            b.send("wait 6")
        g = stream_gpu()
        if g:
            note.append(f"{name} — {g[0]:.1f}" + (f" (кадр {g[1]:.1f}, упаковка {g[2]:.1f})" if g[1] is not None else ""))
    b.note("видеочип на кадр стола, мс, окон Android: " + "; ".join(note))
    for pkg in (A_CALC, A_SETTINGS):
        a_close(b, pkg)
    # игра развёрнута: занятость видеочипа по счётчику ядра (gpubusy: занят / всего, мкс) и вытеснения заданий
    gpu = "cat /sys/class/kgsl/kgsl-3d0/gpubusy /sys/class/kgsl/kgsl-3d0/preempt_count"
    w = a_frame(b, A_GAME)
    b.dclick(a_title(w), wait=3.0)
    b.to((b.dw * 0.5, b.dh * 0.985))
    before = []
    for _ in range(3):   # счётчик gpubusy обнуляется чтением — берём сумму нескольких чтений за шаг
        phone(gpu)
        with b.step("окна-android.игра-развёрнута"):
            b.send("wait 4")
        f = phone(gpu).split()
        before.append((int(f[0]), int(f[1]), int(f[2], 16)))
    p0 = int(phone(gpu).split()[2], 16)
    b.send("wait 4")
    p1 = int(phone(gpu).split()[2], 16)
    busy = [100 * x / max(1, y) for x, y, _ in before]
    g = stream_gpu()
    b.note("игра развёрнута: видеочип занят (gpubusy) " + " / ".join(f"{v:.0f} %" for v in busy)
           + f"; вытеснений заданий за 4 с — {p1 - p0}" + (f"; кадр стола на видеочипе {g[0]:.1f} мс" if g else ""))
    w = a_frame(b, A_GAME)
    b.dclick(a_title(w), wait=2.5)


def cool_down(limit=31.0, timeout=360):
    """ждать, пока корпус телефона остынет: прогоны подряд греют, нагретый режет частоту ядер — сравнивать нельзя"""
    cmd = ("for z in /sys/class/thermal/thermal_zone*; do [ \"$(cat $z/type)\" = skin-therm ] && cat $z/temp; done; true")
    end = time.time() + timeout
    while True:
        t = int(phone(cmd).split()[0]) / 1000
        if t <= limit or time.time() > end:
            print(f"  корпус {t:.1f} °C", flush=True)
            return t
        time.sleep(15)


def s_android_cold(b):
    """Самое тяжёлое для стола: Android включают с нуля и сразу запускают игру — пока она грузится (диск, память, Google
    Play), окно «Файлов» тащат 40 с. Перед этим телефон остывает до 31 °C. Android в начале шага выключается"""
    phone("timeout -s KILL 40 waydroid session stop; true")
    ensure_closed(b, "FilesWindow")
    cool_down()
    b.send("wait 0.2")   # стол мог уйти «без дела» — движение мыши будит
    sc = b.look()
    if not sc.find(t="NMenu"):
        b.click(sc.one(id="nItem"), wait=1.0)
        sc = b.look()
    if not sc.find(id="androidModule"):
        b.click(next(i for i in sc.items if i["t"] == "Text" and i.get("p", {}).get("text") == "ANDROID"), wait=1.0)
        sc = b.look()
    # шестерёнка модуля «03 ANDROID» включает Android и открывает его «Настройки»
    gear = next(i for i in sc.items if i["t"] == "IconButton" and i.get("in") == "androidModule"
                and i.get("p", {}).get("glyph") == "gear")
    t0 = float(phone("python3 -c 'import time; print(time.monotonic())'").strip())
    b.click(gear, wait=1.0)
    if a_picture(b, A_SETTINGS, t0, timeout=90, settle=3.0) is None:
        return
    phone(f"(waydroid app launch {A_GAME} >/dev/null 2>&1 &); true")
    sc = b.look()
    b.click(sc.one(id="fileItem"), wait=1.0)
    sc = b.look()
    spot = title_spot(sc, window(sc, "FilesWindow"))
    with b.step("холодный.игра-грузится"):
        b.drag(spot, 500, 200, 20.0)
    sc = b.look()
    b.click(win_button(sc, window(sc, "FilesWindow"), "close"), wait=0.6)


