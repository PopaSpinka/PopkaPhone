    if pkg in a_wins(b.look()):
        return None
    t0 = float(phone(f"python3 -c 'import time; print(time.monotonic())'; waydroid app launch {pkg} >/dev/null 2>&1 &").strip())
    return a_picture(b, pkg, t0, timeout, settle)


def a_picture(b, pkg, t0, timeout=60, settle=1.5):
    """дождаться картинки окна приложения, запущенного в t0 (часы телефона); ответ — секунд до картинки или None"""
    took = None
    end = time.time() + timeout
    while time.time() < end and took is None:
        b.send("wait 0.4")
        log = phone("journalctl -u naomi-shell --since '-70 s' --no-pager -o short-monotonic | "
                    f"grep 'окно Android {pkg}: картинка'; true")
        for line in log.splitlines():
            t = float(line.split("]")[0].strip("[ "))
            if t >= t0:
                took = t - t0
                break
    if took is None:
        b.note(f"Android: {pkg} не открылся за {timeout} с")
    else:
        print(f"  {pkg}: окно с картинкой через {took:.2f} с", flush=True)
    b.send("wait", settle)
    return took


def a_place(b, pkg, x, y, w, h):
    """задачу Android — в прямоугольник (точки стола; верх — под панелью стола): как стол после растягивания"""
    k = 2400 / b.dw   # пикселей экрана Android в точке стола
    hidden = 64
    for t in a_tasks():
        if t["pkg"] == pkg and t["mode"] == "freeform":
            phone(A_CALL + f"ResizeTask siiiiiiii {pkg} {t['x']} {t['y']} {t['w']} {t['h']} "
                  f"{round(x * k)} {round((y - 40) * k) + hidden} {round(w * k)} {round(h * k)}", check=False)
            b.send("wait 1.2")
            return True
    b.note(f"Android: у {pkg} нет задачи-окна — не поставлено")
    return False


def a_close(b, pkg):
    """закрыть приложение: Shift + крестик; не вышло (крестик за краем, окно на весь экран) — силой в Android"""
    w = a_wins(b.look()).get(pkg)
    if w and "close" in w["buttons"]:
        b.send("down 42 wait 0.05")
        b.click(w["buttons"]["close"], wait=0.3)
        b.send("up 42 wait 1.0")
    if any(t["pkg"] == pkg for t in a_tasks()) or pkg in a_wins(b.look()):
        ash(f"am force-stop {pkg}")
        b.send("wait 1.0")


def a_gfx(b, pkg, label, reset=False):
    """счёт кадров самого приложения (hwui: всего, с опозданием, 50/90/99 %) — в заметки; reset — обнулить"""
    if reset:
        ash(f"dumpsys gfxinfo {pkg} reset >/dev/null")
        return
    out = ash(f"dumpsys gfxinfo {pkg} | grep -E 'Total frames|Janky frames:|percentile|Missed Vsync|Slow UI|deadline missed:'")
    b.note(f"{label} — кадры {pkg} по счёту Android: " + "; ".join(l.strip() for l in out.splitlines()[:9]))


def shot(b, name):
    """снимок стола в папку прогона (между шагами: чтение кадра — 20 мс потока интерфейса)"""
    subprocess.run([os.path.join(ROOT, "tools", "naomi"), "shot", "desk", f"bench-{name}"], capture_output=True)
    src = os.path.join(ROOT, "reports", "screens", f"bench-{name}.png")
