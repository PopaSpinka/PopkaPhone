def a_wins(sc):
    """окна Android на столе: пакет → {win, frame, caption, buttons}; элементы окна идут в сцене следом за ним"""
    out, cur = {}, None
    for i in sc.items:
        if i["t"] == "AndroidWindow":
            cur = {"win": i, "buttons": {}} if i.get("p", {}).get("shown") else None
            if cur:
                out[i["p"].get("pkg", "")] = cur
        elif i["t"] in ("FilesWindow", "WebWindow", "SettingsWindow", "DeskBar"):
            cur = None
        elif cur is not None:
            if i.get("id") == "caption":
                cur["caption"] = i["r"]
            elif i.get("id") == "frameBox":
                cur["frame"] = i["r"]
            elif i["t"] == "WinButton" and i.get("in") == "caption":
                cur["buttons"][i.get("p", {}).get("glyph")] = i
    for v in out.values():   # развёрнутое окно — без краёв для растягивания (frameBox): рамка — от полосы до низа стола
        if "frame" not in v and "caption" in v:
            x, y, w, h = v["caption"]
            v["frame"] = [x, y, w, sc.h - y]
    return {k: v for k, v in out.items() if "frame" in v}


