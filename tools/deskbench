          f"{'light' if xray else ''} > {PHONE_DIR}/sampler.log 2>&1 < /dev/null & true")
    since = phone("date '+%Y-%m-%d %H:%M:%S'").strip()
    # звук: потоки PulseAudio, что играют без «тихо», — тихо на время прогона (список — чтобы вернуть ровно их)
    # не опросом, а по событию «новый поток» (pactl subscribe): опрос раз в 0,5 с сам будил PulseAudio и шину
    # в список — номер потока и имя программы: поток закроют до конца прогона — «без звука» PulseAudio запомнит за
    # программой (module-stream-restore), и её следующий звук начнётся тихим; вернуть — по имени (см. конец прогона)
    quiet = ("pactl list sink-inputs 2>/dev/null | awk '/^Sink Input #/{if(id!=\"\"&&m)print id,app; "
             "id=substr($3,2); m=0; app=\"-\"} /Mute: no/{m=1} /application.name = /{app=$0; sub(/.*= \"/,\"\",app); "
             "sub(/\".*/,\"\",app); gsub(/ /,\"_\",app)} END{if(id!=\"\"&&m)print id,app}' | "
             f"while read i a; do pactl set-sink-input-mute $i 1 && echo $i $a >> {PHONE_DIR}/muted; done")
    mute = subprocess.Popen(NAOMI.ssh_argv(
        f"export XDG_RUNTIME_DIR=/run/user/32011; {quiet}; "
        f"(pactl subscribe & echo $! > {PHONE_DIR}/mute.pid; wait) | grep --line-buffered \"'new' on sink-input\" | "
        f"while read l; do {quiet}; done"),
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) if os.environ.get("DESKBENCH_SOUND") != "1" else None
    if phone(BUS + PROBE + f"Trace {PHONE_DIR}/desk.csv true").strip() != "(true,)":
        sys.exit("зонд стола не включил трассу — оболочка без desk_probe? (tools/naomi build && run)")
    sampling = os.environ.get("DESKBENCH_SAMPLE", "0" if xray else "1") == "1"   # выборки стека потока интерфейса (1 мс)
    if sampling:
        phone(BUS + PROBE + f"Sample {PHONE_DIR}/stacks.txt >/dev/null; true")
    if xray:
        phone(f"cat > {PHONE_DIR}/xray.py", input=open(os.path.join(ROOT, "device", "xray.py")).read())
        phone(f"sudo -n setsid nohup python3 {PHONE_DIR}/xray.py 900 {PHONE_DIR}/xray stop={PHONE_DIR}/stop "
              f"> {PHONE_DIR}/xray.log 2>&1 < /dev/null & true")
    # приставка: свой приёмник с трассами, проверочная мышь построчно
    pi(f"rm -rf {PI_DIR}; mkdir -p {PI_DIR}; sudo systemctl stop naomi-dock; "
       f"sudo env NAOMI_DOCK_TRACE={PI_DIR}/trace.csv NAOMI_DOCK_PTRACE={PI_DIR}/pointer.csv "
       f"{os.environ.get('PI_ENV', '')} nohup {PI.BIN} > {PI_DIR}/dock.log 2>&1 < /dev/null & sleep 4")
    b = Bench(out)
    b.vin = subprocess.Popen(PI.SSH + [f"naomi@{PI.HOST}",
                                       f"sudo python3 {VINPUT} --hz {MOUSE_HZ} --log {PI_DIR}/input.csv --stdin"],
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    failed = None
    try:
        b.send("wait 2.5")
