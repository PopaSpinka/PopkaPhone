# Интернет по кабелю (docs/PI.md, «Интернет по кабелю»): в браузере стола играет настоящий YouTube, кабель вынимают и
# вставляют. Стол должен перейти на Wi-Fi без шва, ролик — играть дальше (видно по кадрам браузера в таблице шагов:
# играет — десятки в секунду); в отчёт — сколько принято по кабелю и по Wi-Fi на каждом отрезке: ролик качается туда,
# куда смотрит маршрут в интернет. Щелчок по плееру — всегда: поток звука браузера числится играющим и на паузе
def net_bytes():
    # кабель «вынут» программно — интерфейса usb0 нет вовсе (0), «вставлен» — он новый, счёт с нуля (см. part)
    out = phone("for i in usb0 wlan0; do cat /sys/class/net/$i/statistics/rx_bytes 2>/dev/null || echo 0; done").split()
    return int(out[0]), int(out[1])


def s_net_cable(b):
    sc = b.look()
    win = web_window(sc)
    if not win:
        b.click(sc.one(id="webItem"), wait=3.0)
        sc = b.look()
        win = web_window(sc)
    if not win:
        b.note("интернет по кабелю: браузер не открылся")
        return
    x, y, w, h = win["r"]
    mine = web_go(b, HEAVY_YOUTUBE, settle=6.0, new=True)   # своя вкладка, в конце закрывается
    parts = []

    def part(name, action=None, sec=20):
        a = net_bytes()
        with b.step(name):
            t = later(1.0, action) if action else None
            b.send(f"wait {sec}")
            if t:
                t.join()
        z = net_bytes()
        d = [(z[k] - a[k] if z[k] >= a[k] else z[k]) / 1e6 for k in (0, 1)]
        parts.append((name, d[0], d[1]))

    try:
        b.click((x + w * 0.33, y + h * 0.40), wait=3.0)   # плеер: пуск
        b.to((x + w * 0.9, y + h * 0.9))   # курсор прочь с плеера
        part("интернет.кабель")
        part("интернет.вынут", UNPLUG)
        part("интернет.wifi")
        part("интернет.вставлен", PLUG)
        part("интернет.снова-кабель")
    finally:
        phone(PLUG, check=False)
        if mine is not None:
            web_cmd({"type": "close", "id": mine})
            b.send("wait 0.5")
    for name, cable, wifi in parts:
        b.note(f"{name}: принято по кабелю {cable:.1f} МБ, по Wi-Fi {wifi:.1f} МБ")


