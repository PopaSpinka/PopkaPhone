def load(name):
    loader = importlib.machinery.SourceFileLoader(name, os.path.join(ROOT, "tools", name))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


os.environ.setdefault("NAOMI_VIA", "wifi")   # кабель телефона — у Pi; к телефону — по Wi-Fi
NAOMI = load("naomi")
PI = load("pi")


def phone(cmd, check=True, input=None):
    p = subprocess.run(NAOMI.ssh_argv(cmd), capture_output=True, text=True, input=input)
    if check and p.returncode:
        sys.exit(f"на телефоне не вышло: {cmd[:100]}\n{p.stderr}")
    return p.stdout


def pi(cmd, check=True):
    p = subprocess.run(PI.SSH + [f"naomi@{PI.HOST}", cmd], capture_output=True, text=True)
    if check and p.returncode:
        sys.exit(f"на Pi не вышло: {cmd[:100]}\n{p.stderr}")
    return p.stdout


# --- сцена стола (зонд) ---------------------------------------------------------------------------------------------

class Scene:
    def __init__(self, data):
        self.w, self.h = data["desk"]
        self.items = data["items"]

    def find(self, t=None, id=None, inn=None, text=None, f=None, **props):
        out = []
        for i in self.items:
            p = i.get("p", {})
            if t and i["t"] != t:
                continue
            if id and i.get("id") != id:
                continue
            if inn and i.get("in") != inn and i.get("id") != inn:
                continue
            if f and not i.get("f", "").startswith(f):
                continue
            if text is not None and p.get("text") != text:
                continue
            if any(p.get(k) != v for k, v in props.items()):
                continue
            x, y, w, h = i["r"]
            if x + w <= 0 or y + h <= 0 or x >= self.w or y >= self.h:   # за краем стола (запас окна)
                continue
            out.append(i)
        return out

    def one(self, **kw):
        found = self.find(**kw)
        if not found:
            raise LookupError(f"в сцене нет {kw}")
        return found[0]


def scene():
    phone(BUS + PROBE + f"Scene {PHONE_DIR}/scene.json >/dev/null; true")
    return Scene(json.loads(phone(f"cat {PHONE_DIR}/scene.json")))


def center(item):
    x, y, w, h = item["r"]
    return x + w / 2, y + h / 2


# --- прогон ---------------------------------------------------------------------------------------------------------

class Bench:
    def __init__(self, out):
        self.out = out
        self.vin = None
        self.sc = None
        self.notes = []
        self.dw, self.dh = 1800, 1012

    # мышь приставки
    def send(self, *cmds):
        line = " ".join(str(c) for c in cmds)
        self.vin.stdin.write(line + "\n")
        self.vin.stdin.flush()
        ok = self.vin.stdout.readline()
        if ok.strip() != "ok":
            raise RuntimeError(f"мышь приставки не ответила на «{line[:60]}»: {ok!r}")

    def look(self):
        """сцена сейчас (зонд — в потоке интерфейса, ~10–40 мс: только между шагами, не внутри)"""
        self.sc = scene()
        self.dw, self.dh = self.sc.w, self.sc.h
        time.sleep(0.25)
        return self.sc

    def frac(self, x, y):
        return f"{min(max(x / self.dw, 0), 0.9999):.4f} {min(max(y / self.dh, 0), 0.9999):.4f}"

    def to(self, target, dx=0, dy=0):
        x, y = center(target) if isinstance(target, dict) else target
        self.send("abs", self.frac(x + dx, y + dy), "wait 0.03")

    def click(self, target, wait=0.4, dx=0, dy=0):
        self.to(target, dx, dy)
        self.send("press wait 0.06 release wait", wait)

    def dclick(self, target, wait=0.5):
        self.to(target)
        self.send("press wait 0.05 release wait 0.08 press wait 0.05 release wait", wait)

    def right(self, target, wait=0.5):
        self.to(target)
        self.send("right wait", wait)

    def hover(self, targets, dwell=0.25):
        for t in targets:
            self.to(t)
            self.send("wait", dwell)

    def counts(self, pts, sec):
        """отсчётов мыши за отчёт, чтобы пройти pts точек стола за sec"""
        return round(pts * MONITOR_W / self.dw / max(1, sec * MOUSE_HZ))

    def drag(self, start, dx, dy, sec, back=True, hold=0.15):
        """зажать в start, протащить на dx, dy точек за sec (мышью, как рукой), отпустить; back — и обратно"""
        self.to(start)
        cx, cy = self.counts(dx, sec), self.counts(dy, sec)
        cmds = ["press", "wait", hold, "rel", cx, cy, sec]
        if back:
            cmds += ["wait", 0.1, "rel", -cx, -cy, sec]
        self.send(*cmds, "wait", 0.1, "release", "wait", 0.4)

    def circle(self, sec, r=6):
        self.send("circle", r, sec)

    def wheel(self, target, n, rate=10):
        self.to(target)
        self.send("wheel", n, rate, "wait 0.5")

    def key(self, *codes, wait=0.4):
        """сочетание: зажать по порядку, отпустить обратно (Shift 42, Alt 56, Esc 1, пробел 57, 3 — 4, 4 — 5)"""
        self.send(*[f"down {c}" for c in codes], "wait 0.05", *[f"up {c}" for c in reversed(codes)], "wait", wait)

    @contextlib.contextmanager
    def step(self, name):
        self.send("mark", f"{name}:start")
        t0 = time.time()
        try:
            yield
        finally:
            self.send("mark", f"{name}:end")
            print(f"  {name}: {time.time() - t0:.1f} с", flush=True)

    def note(self, text):
        print(f"  ! {text}", flush=True)
        self.notes.append(text)


# сценарий: шаги по порядку; каждый сам находит своё в сцене (зонд) и сам убирает за собой

def window(sc, t):
    return sc.one(t=t)


def win_button(sc, win, glyph):
    x, y, w, h = win["r"]
    for b in sc.find(t="WinButton", glyph=glyph):
        bx, by, _, _ = b["r"]
        if x <= bx <= x + w and y <= by <= y + 45:
            return b
    raise LookupError(f"нет кнопки {glyph} у {win['t']}")


def title_spot(sc, win):
    """пустое место полосы окна: правее заголовка, левее кнопок"""
    x, y, w, h = win["r"]
    buttons = [b["r"][0] for b in sc.find(t="WinButton") if x <= b["r"][0] <= x + w and y <= b["r"][1] <= y + 45]
    right = min([bx for bx in buttons if bx > x + w * 0.5] or [x + w - 100])
    return (right - 60, y + 20)


def ensure_closed(b, t):
    sc = b.look()
    for win in sc.find(t=t):
        if win["r"][2] > 0:
            b.click(win_button(sc, win, "close"), wait=0.6)
            sc = b.look()


def s_idle(b):
    with b.step("покой"):
        b.send("wait 4")


def s_cursor(b):
    b.to((b.dw * 0.6, b.dh * 0.6))
    with b.step("курсор"):
        b.circle(3)


def s_panel(b):
    sc = b.look()
    bar = [i for i in sc.find(t="BarItem")]
    with b.step("панель.наведение"):
        b.hover(bar + list(reversed(bar)), dwell=0.2)


def s_nmenu(b):
    sc = b.look()
    n = sc.one(id="nItem")
    with b.step("меню-N.открыть-закрыть"):
        for _ in range(3):
            b.click(n, wait=0.5)
            b.click(n, wait=0.5)
    b.click(n, wait=0.6)
    sc = b.look()
    tiles = sc.find(t="Item", id="tile")
    with b.step("меню-N.плитки"):
        b.hover(tiles + list(reversed(tiles)), dwell=0.15)
    b.send("key 1 wait 0.5")
    if b.look().find(t="NMenu"):
        b.click(n, wait=0.5)


def files_open(b):
    sc = b.look()
    if not sc.find(t="FilesWindow"):
        b.click(sc.one(id="fileItem"), wait=1.0)
        sc = b.look()
    return sc, window(sc, "FilesWindow")


def s_files(b):
    ensure_closed(b, "FilesWindow")
    sc = b.look()
    with b.step("файлы.открыть"):
        b.click(sc.one(id="fileItem"), wait=1.0)
    sc = b.look()
    win = window(sc, "FilesWindow")
    rows = sc.find(id="row")
    with b.step("файлы.наведение-строк"):
        b.hover(rows[:8] + list(reversed(rows[:8])), dwell=0.12)
    # папка с картинками и роликами — test-media (naomi → test-media), иначе Pictures
    target = next((r for r in rows if r.get("p", {}).get("name") == "naomi"), None)
    with b.step("файлы.папки"):
        if target:
            b.dclick(target, wait=0.8)
            sc2 = b.look()
            tm = next((r for r in sc2.find(id="row") if r.get("p", {}).get("name") == "test-media"), None)
            if tm:
                b.dclick(tm, wait=0.8)
        else:
            b.dclick(rows[0], wait=0.8)
    sc = b.look()
    win = window(sc, "FilesWindow")
    rows = sc.find(id="row")
    with b.step("файлы.колесо"):
        lv = sc.one(id="listView") if sc.find(id="listView") else win
        b.wheel(lv, -8, 10)
        b.wheel(lv, 8, 10)
    with b.step("файлы.вид-сетка-список"):
        grid = win_button(sc, win, "grid")
        b.click(grid, wait=0.7)
        sc2 = b.look()
        b.click(win_button(sc2, window(sc2, "FilesWindow"), "list") if sc2.find(t="WinButton", glyph="list") else grid,
                wait=0.7)
    sc = b.look()
    win = window(sc, "FilesWindow")
    rows = sc.find(id="row")
    pic = next((r for r in rows if r.get("p", {}).get("name", "").lower().endswith((".jpg", ".png", ".jpeg"))), None)
    vid = next((r for r in rows if r.get("p", {}).get("name", "").lower().endswith((".mp4", ".mkv", ".webm", ".mov"))), None)
    if pic:
        with b.step("просмотр.фото"):
            b.click(pic, wait=0.3)
            b.send("key 57 wait 1.2")
            b.send("key 1 wait 0.8")
    if vid:
        with b.step("просмотр.видео"):
            b.click(vid, wait=0.3)
            b.send("key 57 wait 3.0")
            b.send("key 1 wait 0.8")
    if rows:
        with b.step("файлы.меню-правой"):
            b.right(rows[0], wait=0.6)
            b.send("key 1 wait 0.5")
    sc = b.look()
    win = window(sc, "FilesWindow")
    with b.step("файлы.тащить"):
        b.drag(title_spot(sc, win), 300, 120, 1.0)
    sc = b.look()
    win = window(sc, "FilesWindow")
    x, y, w, h = win["r"]
    with b.step("файлы.размер-угол"):
        b.drag((x + w + 3, y + h + 3), 160, 100, 1.0)
    with b.step("файлы.размер-край"):
        b.drag((x + w + 3, y + h / 2), -150, 0, 0.8)
    sc = b.look()
    win = window(sc, "FilesWindow")
    with b.step("файлы.развернуть"):
        b.click(win_button(sc, win, "maximize"), wait=0.8)
        sc2 = b.look()
        w2 = window(sc2, "FilesWindow")
        btn = sc2.find(t="WinButton", glyph="restore") or [win_button(sc2, w2, "maximize")]
        b.click(btn[0], wait=0.8)
    sc = b.look()
    win = window(sc, "FilesWindow")
    with b.step("файлы.двойной-по-полосе"):
        b.dclick(title_spot(sc, win), wait=0.8)
        sc2 = b.look()
        b.dclick(title_spot(sc2, window(sc2, "FilesWindow")), wait=0.8)
    sc = b.look()
    win = window(sc, "FilesWindow")
    with b.step("файлы.свернуть-вернуть"):
        b.click(win_button(sc, win, "minimize"), wait=0.8)
        b.click(sc.one(id="fileItem"), wait=0.8)
    sc = b.look()
    with b.step("файлы.закрыть"):
        b.click(win_button(sc, window(sc, "FilesWindow"), "close"), wait=0.8)


def s_files_cycle(b):
    """открыть-закрыть 8 раз (окно открывается там, где закрыли): рывки повторного открытия и рост памяти"""
    ensure_closed(b, "FilesWindow")
    sc = b.look()
    fi = sc.one(id="fileItem")
    b.click(fi, wait=1.0)
    sc = b.look()
    close = win_button(sc, window(sc, "FilesWindow"), "close")
    b.click(close, wait=0.8)
    with b.step("файлы.цикл-8"):
        for _ in range(8):
            b.click(fi, wait=0.9)
            b.click(close, wait=0.7)
    ensure_closed(b, "FilesWindow")


def web_window(sc):
    found = sc.find(t="WebWindow")
    return found[0] if found else None


def s_web(b):
    sc = b.look()
    with b.step("браузер.открыть"):
        b.click(sc.one(id="webItem"), wait=3.0)
    sc = b.look()
    win = web_window(sc)
    if not win:
        b.note("браузер не открылся — шаги браузера пропущены")
        return
    x, y, w, h = win["r"]
    page = (x + w * 0.5, y + h * 0.6)
    with b.step("браузер.колесо"):
        b.wheel(page, -12, 8)
        b.wheel(page, 12, 8)
    with b.step("браузер.тащить"):
        b.drag(title_spot(sc, win), 250, 80, 1.0)
    sc = b.look()
    win = web_window(sc)
    x, y, w, h = win["r"]
    with b.step("браузер.размер-угол"):
        b.drag((x + w + 3, y + h + 3), -160, -90, 1.0)
    sc = b.look()
    win = web_window(sc)
    with b.step("браузер.развернуть"):
        b.dclick(title_spot(sc, win), wait=1.0)
        sc2 = b.look()
        b.dclick(title_spot(sc2, web_window(sc2)), wait=1.0)
    sc = b.look()
    win = web_window(sc)
    plus = sc.find(glyph="plus") or sc.find(glyph="add")
    if plus:
        with b.step("браузер.новая-вкладка"):
            b.click(plus[0], wait=1.2)
            b.send("key 1 wait 0.3")
    sc = b.look()
    win = web_window(sc)
    with b.step("браузер.свернуть-вернуть"):
        try:
            b.click(win_button(sc, win, "minimize"), wait=0.8)
        except LookupError:
            b.click(sc.one(id="webItem"), wait=0.8)
        b.click(sc.one(id="webItem"), wait=1.0)


def s_video_load(b):
    """тяжёлый случай пользователя: в браузере играет ролик (вкладка YouTube), а на столе — меню, окна, перетаскивание.
    Ролик — щелчок по середине плеера (играет/пауза); играет ли — видно по нагрузке Chromium в отчёте"""
    sc = b.look()
    win = web_window(sc)
    if not win:
        b.click(sc.one(id="webItem"), wait=3.0)
        sc = b.look()
        win = web_window(sc)
    if not win:
        b.note("видео: браузер не открылся")
        return
    x, y, w, h = win["r"]
    player = (x + w * 0.33, y + h * 0.35)
    b.click(player, wait=3.0)
    with b.step("видео.играет-покой"):
        b.send("wait 3")
    sc = b.look()
    n = sc.one(id="nItem")
    with b.step("видео.меню-N"):
        for _ in range(3):
            b.click(n, wait=0.5)
            b.click(n, wait=0.5)
    ensure_closed(b, "FilesWindow")
    sc = b.look()
    with b.step("видео.файлы-открыть"):
        b.click(sc.one(id="fileItem"), wait=1.0)
    sc = b.look()
    f = window(sc, "FilesWindow")
    with b.step("видео.файлы-тащить"):
        b.drag(title_spot(sc, f), 300, 100, 1.2)
    sc = b.look()
    with b.step("видео.файлы-закрыть"):
        b.click(win_button(sc, window(sc, "FilesWindow"), "close"), wait=0.8)
    sc = b.look()
    win = web_window(sc)
    if win:
        x, y, w, h = win["r"]
        b.click((x + w * 0.33, y + h * 0.35), wait=0.8)   # пауза


def web_cmd(message=None):
    """команда браузеру стола через зонд (Web) — и что у него за вкладки сейчас"""
    arg = json.dumps(message, ensure_ascii=False) if message else ""
    out = phone(BUS + PROBE + "Web '" + arg.replace("'", "") + "'", check=False).strip()
    try:
        return json.loads(eval(out)[0])   # gdbus: ('{…}',)
    except Exception:
        return {"connected": False, "tabs": []}


def web_go(b, url, settle=6.0, new=False):
    """открыть адрес в активной вкладке (new — в новой) и дождаться конца загрузки (до 25 с), потом — settle секунд
    покоя; ответ — номер вкладки"""
    web_cmd({"type": "new-tab" if new else "navigate", "text": url})
    st = {}
    for _ in range(50):
        time.sleep(0.5)
        st = web_cmd()
        act = [t for t in st["tabs"] if t["id"] == st.get("active")]
        if act and not act[0]["loading"] and url.split("//")[-1].lstrip("/")[:12] in act[0]["url"]:
