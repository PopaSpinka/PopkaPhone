def pct(v, q):
    v = sorted(v)
    return v[min(len(v) - 1, int(q * (len(v) - 1) + 0.5))] if v else float("nan")


def load_run(folder):
    R = {}
    R["input"] = list(csv.DictReader(open(os.path.join(folder, "input.csv"))))
    R["trace"] = [{k: int(v) for k, v in r.items() if v != ""} for r in csv.DictReader(open(os.path.join(folder, "trace.csv")))]
    R["ptr"] = [r for r in csv.DictReader(open(os.path.join(folder, "pointer.csv"))) if r["kind"] == "s"]
    desk = {"t": [], "q": [], "r": [], "e": [], "d": [], "s": []}
    for line in open(os.path.join(folder, "desk.csv"), errors="replace"):
        f = line.rstrip("\n").split(",", 5)
        k = f[0]
        if k == "t" or k == "q":
            desk[k].append((int(f[1]), int(f[2])))
        elif k == "r":
            desk["r"].append((int(f[1]), int(f[2]), int(f[3]), int(f[4]), int(f[5])))
        elif k == "e":
            desk["e"].append(int(f[1]))
        elif k == "d":
            desk["d"].append((int(f[1]), line.split(",", 2)[2].strip()))
        elif k == "s":   # долгое событие потока интерфейса: начало, длилось, на ядре, глубина, в очереди, ядро, тип, кто
            g = line.rstrip("\n").split(",", 8)
            if len(g) > 6 and not g[5].lstrip("-").isdigit():   # записи до 19.11.2026 13:30 — без очереди и ядра
                g = line.rstrip("\n").split(",", 6)
                g = g[:5] + ["-1", "-1"] + g[5:]
            desk["s"].append((int(g[1]), int(g[2]), int(g[3]), int(g[4]), g[7], g[8] if len(g) > 8 else "",
                              int(g[5]), int(g[6])))
    R["desk"] = desk
    R["sys"] = [json.loads(l) for l in open(os.path.join(folder, "sys.jsonl")) if l.strip()]
    R["stacks"] = []
    if os.path.exists(os.path.join(folder, "stacks.txt")):
        for l in open(os.path.join(folder, "stacks.txt"), errors="replace"):
            f = l.rstrip("\n").split(";")
            if len(f) > 1 and f[0].isdigit():
                R["stacks"].append((int(f[0]), f[1:]))
    R["stack_t"] = [t for t, _ in R["stacks"]]
    hz = 75.0
    for line in open(os.path.join(folder, "dock.log"), errors="replace"):
        if line.startswith("экран:") and "Гц" in line:
            try:
                hz = float(line.split(",")[-1].split()[0])
            except ValueError:
                pass
    R["P"] = 1e6 / hz
    R["hz"] = hz
    # сдвиг часов телефон−Pi плывёт (кварцы: ~10 мс за несколько минут) — по каждой строке трассы, а не один на прогон
    offs = sorted((r["recv"], r["offset"]) for r in R["trace"] if r.get("offset"))
    R["off"] = statistics.median(o for _, o in offs) if offs else 0
    R["offs_t"] = [t for t, _ in offs]
    R["offs_v"] = [o for _, o in offs]
    # шаги по меткам
    steps, open_ = [], {}
    for r in R["input"]:
        if r["kind"] == "mark":
            name, _, edge = r["a"].rpartition(":")
            if edge == "start":
                open_[name] = int(r["t"])
            elif name in open_:
                steps.append((name, open_.pop(name), int(r["t"])))
    R["steps"] = steps
    return R


def offset_at(R, t):
    """сдвиг часов телефон−Pi в момент t (часы Pi): ближайшая строка трассы"""
    if not R["offs_t"]:
        return R["off"]
    i = bisect.bisect_left(R["offs_t"], t)
    i = min(max(i, 0), len(R["offs_t"]) - 1)
    if i > 0 and abs(R["offs_t"][i - 1] - t) < abs(R["offs_t"][i] - t):
        i -= 1
    return R["offs_v"][i]


def analyze_span(R, a, b):
    """a, b — время Pi (мкс). Всё, что было между ними"""
    P, off = R["P"], offset_at(R, (a + b) // 2)
    pa, pb = a + off, b + off   # на часах телефона
    out = {"sec": (b - a) / 1e6}
    # монитор
    fr = [r for r in R["trace"] if a <= r["recv"] <= b + 150000 and r["capture"] - off >= a]
    shown = sorted((r for r in fr if r["shown"]), key=lambda r: r["shown"])
    out["frames"] = len(fr)
    out["dropped"] = sum(1 for r in fr if not r["shown"] and not r.get("key"))
    # опорный кадр в покое (чистовой, 0,1 с после анимации) — то же, что на экране: его опоздание не видно
    late = [r for r in shown if r.get("target") and r["shown"] - r["target"] > P / 2 and not r.get("key")]
    out["late"] = len(late)
    lat = [(r["shown"] - (r["capture"] - off)) / 1000 for r in shown]
    out["lat50"], out["lat95"] = pct(lat, .5), pct(lat, .95)
    # телефон: кадры стола
    rs = [r for r in R["desk"]["r"] if pa <= r[0] <= pb]
    work = [(r[1] + r[2] + r[3] + r[4]) / 1000 for r in rs]
    # кадры браузера: кадры стола, к которым страница прислала новую картинку (строка d трассы — #page в WebWindow)
    pg = [t for t, items in R["desk"]["d"] if pa <= t <= pb and "#page@WebWindow" in items]
    pgaps = [(y - x) / 1000 for x, y in zip(pg, pg[1:])]
    out["page"] = len(pg)
    out["page_fps"] = len(pg) / max(0.001, (b - a) / 1e6)
    out["page_gap95"] = pct(pgaps, .95) if pgaps else 0
    out["page_long"] = sum(1 for g in pgaps if g > 2.5 * 16.7)   # разрывы длиннее двух с половиной кадров страницы
    # кадры Android: кадры стола, к которым окно Android прислало новую картинку (слой — AndroidSurface)
    ag = [t for t, items in R["desk"]["d"] if pa <= t <= pb and "AndroidSurface" in items]
    agaps = [(y - x) / 1000 for x, y in zip(ag, ag[1:])]
    out["app"] = len(ag)
    out["app_fps"] = len(ag) / max(0.001, (b - a) / 1e6)
    out["app_gap95"] = pct(agaps, .95) if agaps else 0
    out["app_long"] = sum(1 for g in agaps if 2.5 * P / 1000 < g < 100)   # пропущено больше такта, но не пауза
    out["renders"] = len(rs)
    out["echo"] = sum(1 for e in R["desk"]["e"] if pa <= e <= pb)
    out["work50"], out["work95"] = pct(work, .5), pct(work, .95)
    out["workmax"] = max(work) if work else 0
    out["parts95"] = [pct([r[i] / 1000 for r in rs], .95) for i in (1, 2, 3, 4)] if rs else [0] * 4
    # такт: от отправки на Pi до потока интерфейса телефона (сеть + очередь потока интерфейса); задержан — дольше
    # половины такта: поток интерфейса был занят, кадр к этому такту начнётся поздно
    ticks = [t[0] for t in R["desk"]["t"] if pa - 200000 <= t[0] <= pb + 50000]
    sent = sorted(int(s["sent"]) + off for s in R["ptr"] if s.get("sent") and a <= int(s["sent"]) <= b)
    delays = []
    for s_ in sent:
        j = bisect.bisect_left(ticks, s_ - 3000)
        if j < len(ticks) and ticks[j] - s_ < 60000:
            delays.append((ticks[j] - s_, s_))
    base = pct([d for d, _ in delays], .2) if delays else 0   # сеть: обычная задержка такта
    stalls = [(d - base, s_) for d, s_ in delays if d - base > P / 2]
    out["ticks"] = len(sent)
    out["tick_lost"] = len(sent) - len(delays)
    out["tick95"] = pct([d / 1000 for d, _ in delays], .95)
    out["tickmax"] = max((d / 1000 for d, _ in delays), default=0)
    out["stalls"] = len(stalls)
    # рывки анимаций: кадры идут по такту, и вдруг разрыв в 2–6 тактов, а после — снова по такту. Причина: такты в
    # разрыве задержаны (поток интерфейса занят) — «занят»; такты шли вовремя — сцена в них ничего не просила
    times = [r[0] for r in rs]
    gaps = [y - x for x, y in zip(times, times[1:])]
    busy = idle = 0
    worst = []
    for i, g in enumerate(gaps):
        k = round(g / P)
        # посреди анимации: по 4 ровных шага до и после (иначе — пауза между нажатием и отпусканием, наведением и т. п.)
        if not (2 <= k <= 6) or i < 4 or i + 4 >= len(gaps):
            continue
        if any(round(g_ / P) != 1 for g_ in gaps[i - 4:i] + gaps[i + 1:i + 5]):
            continue
        late_ticks = [st for st in stalls if times[i] - 3000 <= st[1] <= times[i + 1]]
        if late_ticks:
            busy += k - 1
        else:
            idle += k - 1
        worst.append((g / 1000, times[i], times[i + 1]))
    out["hitch_busy"], out["hitch_idle"] = busy, idle
    out["worst"] = sorted(worst, reverse=True)[:3]
    # самые долгие кадры телефона — что в них сменилось
    out["slow"] = sorted(((r[1] + r[2] + r[3] + r[4]) / 1000, r[0]) for r in rs)[-3:][::-1]
    # отклик: от события мыши или клавиши (часы Pi) до первого кадра на мониторе после него (до 0,4 с)
    # отклик — от того, на что интерфейс отвечает сразу: отпустили кнопку (щелчок срабатывает на отпускание), правая
    # кнопка, клавиша нажата, колесо
    ev = [int(r["t"]) for r in R["input"] if a <= int(r["t"]) <= b and
          (r["kind"] in ("release", "wheel", "right") or (r["kind"] == "key" and r["b"] == "1"))]
    caps = sorted(((r["capture"] - off), r["shown"]) for r in shown)
    ct = [c for c, _ in caps]
    resp = []
    for e in ev:
        j = bisect.bisect_right(ct, e)
        if j < len(caps) and caps[j][1] - e < 400000:
            resp.append((caps[j][1] - e) / 1000)
    out["resp50"], out["respmax"], out["resp_n"] = pct(resp, .5), max(resp, default=float("nan")), len(resp)
    out["misses"] = out["dropped"] + out["late"]
    # долгие события потока интерфейса (≥ 4 мс): самые долгие, вложенные — с глубиной
    ev_long = [e for e in R["desk"]["s"] if pa <= e[0] <= pb]
    out["busy_ms"] = sum(e[1] for e in ev_long if e[3] == 1) / 1000
    out["long_events"] = sorted(ev_long, key=lambda e: -e[1])[:4]
    # система
    S = [s for s in R["sys"] if pa / 1e6 <= s["t"] <= pb / 1e6]
    if S:
        mean = lambda v: statistics.mean(v) if v else float("nan")
        out["cpu"] = mean([sum(s["cpu"]) / 8 for s in S])
        out["little"] = mean([sum(s["cpu"][:6]) / 6 for s in S])
        out["big"] = mean([sum(s["cpu"][6:]) / 2 for s in S])
        out["corepeak"] = max(max(s["cpu"]) for s in S)
        out["f"] = [mean([s["f"][i] for s in S]) for i in range(3)]
        out["gpu"] = mean([s["gpu"] for s in S])
        out["gmhz"] = mean([s["gmhz"] for s in S])
        out["w"] = mean([s["w"] for s in S])
        out["skin"] = max(s["temp"].get("skin", 0) for s in S)
        out["tbig"] = max(s["temp"].get("big", 0) for s in S)
        procs, threads = {}, {}
        n = 0
        for s in S:
            if "procs" in s:
                n += 1
                for c, name, pid, rss in s["procs"]:
                    procs[name] = procs.get(name, 0) + c
                for c, name, tid, cpu in s.get("threads", []):
                    key = f"{name}"
                    threads.setdefault(key, [0, 0, 0])
                    threads[key][0] += c
                    threads[key][1 if cpu < 6 else 2] += 1
        out["procs"] = sorted(((c / max(1, n), k) for k, c in procs.items()), reverse=True)[:5]
        out["threads"] = sorted(((v[0] / max(1, n), k, v[1], v[2]) for k, v in threads.items()), reverse=True)[:5]
        rss = [s["shell_rss"] for s in S if "shell_rss" in s]
        cool = {}
        for s_ in S:
            for k, v in s_.get("cool", {}).items():
                cool[k] = max(cool.get(k, 0), v)
        out["cool"] = cool
        out["temps"] = {k: max(s_["temp"].get(k, 0) for s_ in S) for k in S[-1]["temp"]}
        out["rss"] = rss[-1] if rss else 0
        out["memavail"] = min((s["mem_avail"] for s in S if "mem_avail" in s), default=0)
    return out


# рамки, которые есть почти в каждой выборке, — не ответ на «что внутри»
STACK_SKIP = ("main", "__libc_start", "_start", "QCoreApplication::exec", "QEventLoop::", "QGuiApplication::notify",
              "QCoreApplication::notifyInternal", "QCoreApplicationPrivate::notify_helper", "ProbedApp::notify",
              "QObject::event", "QEventDispatcher", "g_main_context", "QCoreApplicationPrivate::sendPostedEvents",
              "QCoreApplication::sendPostedEvents", "QMetaCallEvent::placeMetaCall", "QQuickWindow::event",
              "QWindow::event", "QQuickDeliveryAgent", "QGuiApplicationPrivate::process", "?", "[jit]", "QtPrivate::",
              "QMetaObject::activate", "doActivate", "QQmlBoundSignal", "QQmlJavaScriptExpression::evaluate",
              "QV4::", "QQmlObjectOrGadget", "QObject::", "QMetaMethod::invoke", "QQmlVMEMetaObject::metaCall")


def stacks_in(R, t0, t1):
    i = bisect.bisect_left(R["stack_t"], t0)
    j = bisect.bisect_right(R["stack_t"], t1)
    return [R["stacks"][k][1] for k in range(i, j)]


def stack_summary(st, top=6):
    """что внутри: свои функции (где поток стоял) и охватывающие (без вездесущих рамок), доля выборок"""
    if not st:
        return ""
    own, incl = {}, {}
    for frames in st:
        inner = next((f for f in reversed(frames) if not f.startswith(("[jit]", "?"))), frames[-1])
        own[inner] = own.get(inner, 0) + 1
        for f in set(frames):
            if not f.startswith(STACK_SKIP) and not f.startswith("main "):
                incl[f] = incl.get(f, 0) + 1
    n = len(st)
    fmt_ = lambda d: ", ".join(f"{k[:70]} {100 * v // n}%" for k, v in sorted(d.items(), key=lambda kv: -kv[1])[:top])
    return f"выборок {n}; внутри: {fmt_(incl)} || стоял в: {fmt_(own)}"


def first_frames(R):
    """путь кадра по участкам: первый после паузы (стол стоял ≥ 0,1 с) против кадров движения — где теряется время
    начала каждой анимации, щелчка, наведения; и сколько их не успело к своему обновлению монитора"""
    sent_of = {int(r["value"]): int(r["sent"]) for r in R["ptr"] if r.get("value") and r.get("sent")}
    groups = {"первый": [], "2–4": [], "движение": [], "опорный": []}
    size = {k: [] for k in groups}
    miss = {k: 0 for k in groups}
    prev, idx = None, 0
    for r in sorted(R["trace"], key=lambda r: r["capture"]):
        idx = 0 if prev is None or r["capture"] - prev > 100000 else idx + 1
        prev = r["capture"]
        t = r.get("target", 0)
        if t not in sent_of:
            continue
        k = "опорный" if r.get("key") else "первый" if idx == 0 else "2–4" if idx < 4 else "движение"
        sent = sent_of[t] + r["offset"]
        groups[k].append(((r["capture"] - sent) / 1000, (r["encoded"] - r["capture"]) / 1000,
                          (r["recv"] - (r["encoded"] - r["offset"])) / 1000, (r["decoded"] - r["recv"]) / 1000,
                          (r["decoded"] - sent_of[t]) / 1000))
        if not r["shown"] or r["shown"] - t > R["P"] / 2:
            miss[k] += 1
        if r.get("bytes"):
            size[k].append(r["bytes"] / 1024)
    out = ["Путь кадра, мс (медиана / 90 %): такт → снят на телефоне | сжат | кабель | распакован на Pi | итого от такта;"
           " не успели к своему обновлению"]
    for k, v in groups.items():
        if v:
            f = lambda i: f"{pct([x[i] for x in v], .5):4.1f}/{pct([x[i] for x in v], .9):4.1f}"
            kb = f"; КБ {pct(size[k], .5):.0f}/{pct(size[k], .9):.0f}" if size[k] else ""
            out.append(f"  {k:9s} {len(v):5d}: {f(0)} | {f(1)} | {f(2)} | {f(3)} | {f(4)};  {miss[k]} ({100 * miss[k] / len(v):.0f} %){kb}")
    return out + [""]


def what_changed(R, t0, t1):
    """что сменилось в сцене к кадрам между t0 и t1 (строки d трассы) — подсказка, кто рисовал"""
    seen = {}
    for t, items in R["desk"]["d"]:
        if t0 <= t <= t1:
            for it in items.split(";"):
                name = it.split("=")[0]
                if name:
                    seen[name] = seen.get(name, 0) + 1
    return sorted(seen.items(), key=lambda kv: -kv[1])[:4]


def fmt(v, d=0):
    return "—" if v != v else f"{v:.{d}f}"


def analyze(folder):
    R = load_run(folder)
    P = R["P"]
    lines = [f"Прогон стола {os.path.basename(folder)}: монитор {R['hz']:.2f} Гц (такт {P / 1000:.2f} мс), "
             f"сдвиг часов телефон−Pi {R['off'] / 1e6:.3f} с, шагов {len(R['steps'])}", ""]
    lines += first_frames(R)
    lines.append("Шаг                          | сек | кадров тел/мон | пропуски мон | рывки анимаций | кадр тел мс     | такт→UI мс    | отклик мс | до экрана | ЦП % мал/бол | ГП %  МГц | Вт  | °C   | RSS")
    lines.append("                             |     |                | выбр+опозд   | занят/не прос. | 50 / 95 / max   | 95/max (задер)| 50 / max  | мс 50     |              |           |     |      | МБ")
    summary = {}
    for name, a, b in R["steps"]:
        s = analyze_span(R, a, b)
        summary[name] = {k: v for k, v in s.items() if k not in ("worst", "procs", "threads", "slow")}
        nan = float("nan")
        lines.append(
            f"{name[:28]:<28} | {s['sec']:3.1f} | {s['renders']:4d}/{s['frames']:<4d}     | {s['dropped']:3d}+{s['late']:<3d}      |"
            f" {s['hitch_busy']:3d} / {s['hitch_idle']:<3d}      | {fmt(s['work50'], 1):>4}/{fmt(s['work95'], 1):>4}/{fmt(s['workmax'], 0):>3}  "
            f"   | {fmt(s['tick95'], 1):>4}/{fmt(s['tickmax'], 0):>3} ({s['stalls']:2d}) | {fmt(s['resp50']):>3}/{fmt(s['respmax']):>4}  "
            f"| {fmt(s['lat50']):>4}      | {fmt(s.get('little', nan)):>3}/{fmt(s.get('big', nan)):>3}      "
            f"| {fmt(s.get('gpu', nan)):>3} {fmt(s.get('gmhz', nan)):>4}  | {fmt(s.get('w', nan), 1)} | {fmt(s.get('skin', nan), 1)} | {s.get('rss', 0)}")
    lines.append("")
    lines.append("Подробно по шагам (худшие шаги кадров телефона, кто ел процессор, потоки оболочки — %, малые/большие ядра):")
    for name, a, b in R["steps"]:
        s = analyze_span(R, a, b)
        bad = s["hitch_busy"] + s["misses"] + s["stalls"]
        detail = []
        for gap, t0, t1 in s["worst"]:
            ch = what_changed(R, t0, t1)
            detail.append(f"разрыв {gap:.0f} мс" + (" (сменилось: " + ", ".join(f"{n}×{c}" for n, c in ch) + ")" if ch else ""))
        slow = []
        for ms, t0 in s["slow"]:
            if ms >= 6:
                ch = what_changed(R, t0 - 1, t0 + 1)
                slow.append(f"{ms:.1f} мс" + (" (" + ", ".join(f"{n}" for n, c in ch[:3]) + ")" if ch else ""))
        procs = ", ".join(f"{n} {c:.0f}" for c, n in s.get("procs", []))
        thr = ", ".join(f"{n} {c:.0f} ({l}/{bg})" for c, n, l, bg in s.get("threads", []))
        lines.append(f"• {name}: {'ПЛОХО: ' if bad else ''}задержка до экрана {fmt(s['lat50'])}/{fmt(s['lat95'])} мс; "
                     f"части кадра 95% (polish/sync/render/end) {'/'.join(fmt(x, 1) for x in s['parts95'])} мс; "
                     f"частоты мал/б/б+ {'/'.join(fmt(x) for x in s.get('f', [])) or '—'} МГц; ядро до {s.get('corepeak', '—')}%")
        if s.get("cool"):
            lines.append("    ограничители по нагреву (ступень): " + ", ".join(f"{k} {v}" for k, v in sorted(s["cool"].items()))
                         + "; датчики, °C: " + ", ".join(f"{k} {v:.1f}" for k, v in sorted(s.get("temps", {}).items())))
        if s.get("page", 0) >= 5:
            lines.append(f"    кадры браузера: {s['page']} ({s['page_fps']:.1f}/с), шаг 95 % {s['page_gap95']:.1f} мс, "
                         f"разрывов длиннее 42 мс: {s['page_long']}")
        if s.get("app", 0) >= 5:
            lines.append(f"    кадры Android: {s['app']} ({s['app_fps']:.1f}/с), шаг 95 % {s['app_gap95']:.1f} мс, "
                         f"разрывов длиннее 2,5 такта: {s['app_long']}")
        if detail:
            lines.append("    рывки: " + "; ".join(detail))
        if slow:
            lines.append("    долгие кадры: " + "; ".join(slow))
        if s["long_events"]:
            outer = [e for e in s["long_events"] if e[3] == 1]
            q = sum(e[6] for e in outer if e[6] > 0) / 1000
            run = sum(e[2] for e in outer) / 1000
            if R["stacks"]:
                for e in sorted(outer, key=lambda e: -e[1])[:2]:
                    if e[1] >= 12000:
                        lines.append(f"    в событии {e[1] / 1000:.0f} мс ({e[4]}): " + stack_summary(stacks_in(R, e[0], e[0] + e[1])))
            lines.append(f"    поток интерфейса занят событиями ≥ 4 мс: {s['busy_ms']:.0f} мс (самые долгие: на ядре {run:.0f}, "
                         f"ждал ядро {q:.0f}, спал {max(0, sum(e[1] for e in outer) / 1000 - run - q):.0f}); " + "; ".join(
                f"{e[1] / 1000:.0f} мс (ЦП {e[2] / 1000:.0f}" + (f", очередь {e[6] / 1000:.0f}" if e[6] > 0 else "")
                + f", ядро {e[7]}) {e[4]}→{e[5][:70]}" + (f" [вложено {e[3]}]" if e[3] > 1 else "")
                for e in s["long_events"]))
        if procs:
            lines.append("    процессы: " + procs)
        if thr:
            lines.append("    потоки оболочки: " + thr)
    # журнал оболочки — ошибки QML и предупреждения за прогон
    log = open(os.path.join(folder, "shell.log"), errors="replace").read().splitlines()
    warn = [l for l in log if any(w in l for w in ("TypeError", "ReferenceError", "Binding loop", "warning", "Warning",
                                                     "Error", "не удалось", "не открыть"))]
    if warn:
        lines.append("")
        lines.append(f"Журнал оболочки: предупреждений и ошибок {len(warn)} (первые 12):")
        seen = set()
        for l in warn:
            key = l.split(": ", 1)[-1][:120]
            if key in seen:
                continue
            seen.add(key)
            lines.append("    " + l[-200:])
            if len(seen) >= 12:
                break
    # пробный приёмник гасят SIGINT в конце прогона: чистый выход — строка «выход» и после неё ничего о падении
    # (20 ноября «terminate called» после «выход» нашли в двух отчётах случайно — docs/PI.md, «Выход приёмника»)
    dock = open(os.path.join(folder, "dock.log"), errors="replace").read().splitlines()
    after = dock[dock.index("выход") + 1:] if "выход" in dock else None
    bad = [l for l in after or [] if any(w in l for w in ("terminate called", "Aborted", "Segmentation", "core dumped"))]
    if after is None or bad:
        lines.append("")
        lines.append("Приставка: пробный приёмник вышел не чисто — " + ("в журнале нет «выход» (не дошёл до выхода)"
                     if after is None else "после «выход»: " + " / ".join(bad[:3])))
    notes = open(os.path.join(folder, "notes.txt")).read().strip() if os.path.exists(os.path.join(folder, "notes.txt")) else ""
    if notes:
        lines.append("")
        lines.append("Заметки сценария:\n" + notes)
    json.dump(summary, open(os.path.join(folder, "summary.json"), "w"), ensure_ascii=False, indent=1)
    text = "\n".join(lines)
    open(os.path.join(folder, "report.txt"), "w").write(text + "\n")
    return text


def compare(a, b):
    A = json.load(open(os.path.join(a, "summary.json")))
    B = json.load(open(os.path.join(b, "summary.json")))
    keys = [("misses", "пропуски мон"), ("hitch_busy", "рывки занят"), ("hitch_idle", "не просила"),
            ("work95", "кадр 95%"), ("stalls", "такт задерж"), ("resp50", "отклик"), ("lat50", "до экрана"),
            ("cpu", "ЦП %"), ("w", "Вт")]
    print(f"{'шаг':<28} " + " ".join(f"{h:>14}" for _, h in keys))
    for name in A:
        if name not in B:
            continue
        cells = []
        for k, _ in keys:
            x, y = A[name].get(k, float("nan")), B[name].get(k, float("nan"))
            cells.append(f"{fmt(x, 1):>6}→{fmt(y, 1):<6}")
        print(f"{name[:28]:<28} " + " ".join(f"{c:>14}" for c in cells))


def show_scene(words):
    sc = scene()
    print(f"стол {sc.w}×{sc.h}, элементов {len(sc.items)}")
    for i in sc.items:
        s = json.dumps(i, ensure_ascii=False)
        if not words or any(w in s for w in words):
            print(s)


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "help"
    if cmd == "run":
        names = args[1:] or ORDER
        bad = [n for n in names if n not in STEPS]
        if bad:
            sys.exit(f"нет шагов {bad}; есть: {' '.join(STEPS)}")
        run(names)
    elif cmd == "list":
        print("по порядку: " + " ".join(ORDER))
        print("отдельно: " + " ".join(n for n in STEPS if n not in ORDER))
    elif cmd == "again":
        for f in args[1:]:
            print(analyze(f))
    elif cmd == "compare":
        compare(args[1], args[2])
    elif cmd == "scene":
        show_scene(args[1:])
    elif cmd == "history" and args[1:] in (["save"], ["restore"]):
        history(args[1])
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
