        except Exception:
            b.vin.kill()
        pi(f"sudo pkill -INT -x naomi-dock; sleep 1; sudo chmod a+r {PI_DIR}/*; sudo systemctl start naomi-dock", check=False)
        phone(BUS + PROBE + "Trace '' false >/dev/null; touch " + PHONE_DIR + "/stop", check=False)
        if sampling:
            phone(BUS + PROBE + "Sample '' >/dev/null; true", check=False)
        time.sleep(1.5)
        if mute:
            mute.terminate()
            # потоки, что ещё играют, — звук им; закрытые — программе: пробный поток тишины с её именем, звук ему,
            # PulseAudio запомнит «со звуком»
            phone(f"kill $(cat {PHONE_DIR}/mute.pid) 2>/dev/null; export XDG_RUNTIME_DIR=/run/user/32011; "
                  f"sort -u {PHONE_DIR}/muted 2>/dev/null | while read i a; do "
                  "pactl set-sink-input-mute $i 0 2>/dev/null || echo $a; done | sort -u | grep -v '^-$' | "
                  "while read a; do (timeout 2 pacat --client-name=$a --property=application.name=$a --raw "
                  "--format=s16le --rate=48000 --channels=2 < /dev/zero &); sleep 0.8; "
                  "pactl list sink-inputs | awk -v a=$a '/^Sink Input #/{id=substr($3,2)} /application.name = /"
                  "{x=$0; sub(/.*= \"/,\"\",x); sub(/\".*/,\"\",x); if(x==a)print id}' | "
                  "while read n; do pactl set-sink-input-mute $n 0; done; done; true", check=False)
        # свои скриншоты — прочь (чужие не трогать)
        new = [s for s in phone("ls ~/Screenshots 2>/dev/null; true").split("\n") if s and s not in shots_before]
        if new:
            phone("cd ~/Screenshots && rm -f -- " + " ".join(f"'{s}'" for s in new), check=False)
        subprocess.run(["scp", "-q", *PI.SSH[1:], f"naomi@{PI.HOST}:{PI_DIR}/*", out])
        for f in ("desk.csv", "sys.jsonl", "stacks.txt"):
            open(os.path.join(out, f), "w").write(phone(f"cat {PHONE_DIR}/{f}", check=False))
        open(os.path.join(out, "shell.log"), "w").write(
            phone(f"journalctl -u naomi-shell --since '{since}' --no-pager -o short-monotonic", check=False))
        open(os.path.join(out, "notes.txt"), "w").write("\n".join(b.notes) + "\n")
        if xray:   # трасса ядра: дождаться, пока рентген допишет (сжатие — секунды), и забрать
            xdir = os.path.join(out, "xray")
            os.makedirs(xdir)
            for _ in range(90):
                if phone(f"pgrep -f '[x]ray.py' >/dev/null && echo busy; true").strip() != "busy":
                    break
                time.sleep(1)
            tar = subprocess.Popen(NAOMI.ssh_argv(f"tar -C {PHONE_DIR}/xray -cf - ."), stdout=subprocess.PIPE)
            subprocess.run(["tar", "-C", xdir, "-xf", "-"], stdin=tar.stdout)
            tar.wait()
            phone(f"sudo -n rm -rf {PHONE_DIR}/xray", check=False)
    if failed:
        print(f"прогон прерван: {failed!r}", flush=True)
        if not isinstance(failed, Exception):
            raise failed
    report = analyze(out)
    print(report)
    if xray and os.path.exists(os.path.join(out, "xray", "trace.gz")):
        xray_steps(out)


def xray_steps(out):
    """Рентген по шагам: шаги прогона (часы Pi) → часы телефона → отчёт tools/xray на каждый шаг."""
    X = load("xray")
    R = load_run(out)
    xdir = os.path.join(out, "xray")
    steps = [{"name": n, "t0": (a + offset_at(R, a)) / 1e6, "t1": (b + offset_at(R, b)) / 1e6} for n, a, b in R["steps"]]
    json.dump(steps, open(os.path.join(xdir, "steps.json"), "w"), ensure_ascii=False, indent=1)
    X.report(X.Trace(xdir))
    for s in steps:
        text = X.report(X.Trace(xdir, window=(s["t0"], s["t1"]), title=s["name"]))
        if "НЕ ВЕРИТЬ" in text:   # буфер трассы переполнился до конца шага — см. tools/xray, «ВНИМАНИЕ»
            print(f"РЕНТГЕН ШАГА «{s['name']}» НЕВЕРЕН: буфер трассы переполнился до конца шага — шаг короче или отдельно")
    print(f"рентген: {os.path.relpath(xdir, ROOT)}/report.txt и report-ШАГ.txt (tools/xray step {os.path.relpath(xdir, ROOT)} ШАГ)")


