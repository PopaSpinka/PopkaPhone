    print(f"прогон → {os.path.relpath(out, ROOT)}", flush=True)
    # телефон: папка, сборщик, трасса стола, звук браузера — тихо
    # сторож тишины прошлого прогона, если тот оборвался (20 ноября 2026 такой с утра глушил каждый новый звук
